// --- ゲームの出力先の束 (canvas + message area) -------------------------------
//
// これは `docs/ui-api.md` の UI Element `Window` とは別物である。
// こちらは `Game` が内部的に持つ、出力先 (Canvas / MessageArea の UI Element) の
// ui_id の束で、scene からは `game.window.wait()` のように使われる。
// UI Element の `Window` (root element) は本ファイル下部の「UI Element」節にある。
//
// `GameWindow` はランタイムが Window の ScenePage の Canvas / MessageArea から組み立てて、
// `SceneStartButton` の `on_click(window)` に渡す。
// ランタイムは Biwa の値を直接は作れないので、下の host export
// `__biwa_std_game_window_new` を呼んで作る。
//
// コンパイラはこの型を知らない (lang item ではない)。ランタイムとの取り決めは
// host export の名前と引数 (ui_id 2 つ) だけである。
pub struct GameWindow {
  // Canvas API の出力先。無ければ Canvas API は使えない。
  canvas: Option[GameCanvas],
  // Content API の出力先。無ければ Content API は使えない。
  message_area: Option[GameMessageArea],
}

impl GameWindow {
  // 引数は出力先の UI Element (`Canvas` / `MessageArea`)。
  fn new(canvas: Option[UiId], message_area: Option[UiId]) -> Self {
    Self {
      canvas = match canvas {
        Some(id) => Some(GameCanvas { ui_id = id }),
        None => None,
      },
      message_area = match message_area {
        Some(id) => Some(GameMessageArea { ui_id = id }),
        None => None,
      },
    }
  }

  // クリックが来るまでシーンを止める。
  //
  // クリックはどの出力先にも属さないので ui_id を取らない。
  pub(super) fn wait(self) {
    wait();
  }

  pub(super) fn canvas(self) -> Option[GameCanvas] {
    self.canvas
  }

  pub(super) fn message_area(self) -> Option[GameMessageArea] {
    self.message_area
  }

  // fn width(self) -> Uint;
  // fn height(self) -> Uint;
}

// ランタイムが `GameWindow` を組み立てるための入口。
//
// ホスト (JS) は Biwa の `Option` を組み立てられない (wasm では WasmGC の値) ので、
// 素の ui_id を受け取り、**0 を「無し」**として扱う。
// ui_id は 1 から振られるので 0 はどの Element とも重ならない。
//
// `GameWindow::new` は関連関数なので host export の付与対象 (トップレベルの `fn`) に入らず、
// この薄いラッパーを置いている。
[[host_export="__biwa_std_game_window_new"]]
fn game_window_new_for_host(canvas_id: Uint, message_area_id: Uint) -> GameWindow {
  GameWindow::new(ui_id_or_none(canvas_id), ui_id_or_none(message_area_id))
}

// ホストから来た ui_id の 0 を「無し」に読み替える。
fn ui_id_or_none(id: Uint) -> Option[UiId] {
  if id == 0 {
    None
  } else {
    Some(UiId::new(id))
  }
}

// Canvas API の出力先。UI Element `Canvas` の ui_id を持つだけの薄い struct。
pub struct GameCanvas {
  ui_id: UiId,
}

impl GameCanvas {
  // fn create_image(self, image: Image, x: Int, y: Int, width: Option[Uint], height: Option[Uint]);

  pub(super) fn ui_id(self) -> UiId {
    self.ui_id
  }
}

// Content API の出力先。UI Element `MessageArea` の ui_id を持つだけの薄い struct。
//
// syscall には出力先としてこの ui_id を第一引数で渡す。
pub(super) struct GameMessageArea {
  ui_id: UiId,
}

impl GameMessageArea {
  // テキストを 1 つ積む。まだ描画されない。
  //
  // 引数はすべて**解決済みの絶対値**である。設定を読んで
  // ここに渡す形にするのは `std::game::content` の仕事で、
  // ここは設定を知らない。
  //
  pub(super) fn push_text(self, text: String, speed: Float, size: Size, weight: TextWeight, color: Color) {
    content_push_text(self.ui_id, text, speed, size, weight, color);
  }

  // 積まれたものをまとめて出し始める。
  pub(super) fn flush(self) {
    content_flush(self.ui_id);
  }

  // 枠を空にする。呼ぶ時機を決めるのは std であってエンジンではない。
  pub(super) fn clear(self) {
    content_clear(self.ui_id);
  }

  // fn set_talker_name(self, name: String);
  // fn set_talker_image(self, image: Image);
}

pub enum Size {
  // All of these `Float` value must be positive.
  Vw(Float), // 100.0 means 100 % of viewport width.
  Vh(Float), // 100.0 means 100 % of viewport height.

  // vw, vh との相互変換が難しいため保留
  // エンジン側に処理させる必要があるかもしれない
  // Px(Float),
}

impl Size {
  pub(super) fn mul(self, mul: Float) -> Self {
    match self {
      Size::Vw(vw) => Size::Vw(vw * mul),
      Size::Vh(vh) => Size::Vh(vh * mul),
      // Size::Px(px) => Size::Px(px * mul),
    }
  }
}

// --- UI Element --------------------------------------------------------
//
// `docs/ui-api.md` の Phase1 (syscall + std 抽象化) の実装。
// 実装方針・実装しながら確定した内容は `docs/ui-api-impl-status.md` を参照。
//
// 運用イメージ: syscall はコンストラクタの都度発行しない。
// まず Biwa (Wasm runtime) 側で `UiElement` の値としての木を組み立て、
// 最後にその木を丸ごと再帰的に辿って syscall を発行し、
// エンジン側にデータ構造をコピーする。Biwa 側の値が正で、
// エンジンへは一方的に副作用として反映されるだけ、という
// Biwa Engine 全体の構成をここでも踏襲している。
//
// `Window` / `Page` は enum `UiElement` の variant ではなく独立した型である。
// Window の子は Page のみ、Page の子は任意の UiElement、という木構造の制約を
// 型で表すためで、`docs/ui-api.md` の XML-based Syntax 節が
// `UiElement` と `UiPage` (= ここでの `Page`) を別の型として扱っているのに合わせた。

// UI Element の property。番号と値の詰め方 (エンジンとの ABI) は `base_engine::ui_set_property` が持つ。
pub(super) enum UiProperty {
  Width(UiSize),
  Height(UiSize),
  MarginLeft(UiSize),
  MarginRight(UiSize),
  MarginTop(UiSize),
  MarginBottom(UiSize),
  PaddingLeft(UiSize),
  PaddingRight(UiSize),
  PaddingTop(UiSize),
  PaddingBottom(UiSize),
  BackgroundColor(Color),
  Column(Uint),
  TextSize(UiSize),
  TextWeight(Uint),
  TextColor(Color),
  WindowScenePage(ScenePageId),
  ScenePageCanvas(CanvasId),
  ScenePageMessageArea(MessageAreaId),
  PageId(String),
  OnClickLink(String),
  Text(String),
  TextFont(String),
  BackgroundImage(String),
  Image(String),
  Id(String),
}

// UI Element のハンドラ (ホストが後で呼ぶ関数)。番号は `base_engine::ui_set_handler` が持つ。
pub(super) enum UiEventHandler[S] {
  WindowMainScene(Scene[S]),
  SceneStartButtonOnClick(fn(GameWindow) -> Game[S]),
}

// UI のレイアウトで使う大きさ。Message Window の `Size` (vw/vh のみ) と違い、
// 親要素に対する割合 (`percent`) も持つので、あえて別の型にしてある。
pub enum UiSize {
  Vw(Float),
  Vh(Float),
  Percent(Float),
}

pub fn vw(value: Float) -> UiSize { UiSize::Vw(value) }
pub fn vh(value: Float) -> UiSize { UiSize::Vh(value) }
pub fn percent(value: Float) -> UiSize { UiSize::Percent(value) }

// `background_color` と `background_image` は排他である (`docs/ui-api.md`)。
// 2 つの `Option` を別々に持たせると両方設定できてしまうので、
// 1 つの enum にして型で排他性を保証する。
enum Background {
  Color(Color),
  Image(String),
}

// `Option[Background]` を数値または文字列 property として発行する。
// 未設定 (`None`) なら何もしない。
fn apply_background(id: UiId, background: Option[Background]) {
  match background {
    Some(background) => { ui_set_property(id, background.as_property()); }
    None => {}
  }
}

impl Background {
  fn as_property(self) -> UiProperty {
    match self {
      Background::Color(c) => UiProperty::BackgroundColor(c),
      Background::Image(image) => UiProperty::BackgroundImage(image),
    }
  }
}

// すべての Element に共通する `id` property を発行する。未設定 (`None`) なら何もしない。
// エンジン側はこの文字列から ui_id を逆引きできる (Page の `canvas`/`message_area` 等で使う)。
fn apply_id(id: UiId, name: Option[String]) {
  match name {
    Some(name) => { ui_set_property(id, UiProperty::Id(name)); }
    None => {}
  }
}

// Box / Link / Horizontal / Vertical / HorizontalGrid に共通するレイアウト系
// property をまとめて発行する。property を増やすときはここ 1 箇所を触ればよい。
fn apply_layout_properties(
  id: UiId,
  width: Option[UiSize],
  height: Option[UiSize],
  margin_left: Option[UiSize],
  margin_right: Option[UiSize],
  margin_top: Option[UiSize],
  margin_bottom: Option[UiSize],
  padding_left: Option[UiSize],
  padding_right: Option[UiSize],
  padding_top: Option[UiSize],
  padding_bottom: Option[UiSize],
  background: Option[Background],
) {
  apply_size(id, width, fn(v) { UiProperty::Width(v) });
  apply_size(id, height, fn(v) { UiProperty::Height(v) });
  apply_size(id, margin_left, fn(v) { UiProperty::MarginLeft(v) });
  apply_size(id, margin_right, fn(v) { UiProperty::MarginRight(v) });
  apply_size(id, margin_top, fn(v) { UiProperty::MarginTop(v) });
  apply_size(id, margin_bottom, fn(v) { UiProperty::MarginBottom(v) });
  apply_size(id, padding_left, fn(v) { UiProperty::PaddingLeft(v) });
  apply_size(id, padding_right, fn(v) { UiProperty::PaddingRight(v) });
  apply_size(id, padding_top, fn(v) { UiProperty::PaddingTop(v) });
  apply_size(id, padding_bottom, fn(v) { UiProperty::PaddingBottom(v) });
  apply_background(id, background);
}

// 大きさの property を 1 つ発行する。未設定 (`None`) なら何もしない。
// `prop` は値からその property を作る関数 (`fn(v) { UiProperty::Width(v) }` など)。
fn apply_size(id: UiId, size: Option[UiSize], prop: fn(UiSize) -> UiProperty) {
  match size {
    Some(size) => { ui_set_property(id, prop(size)); }
    None => {}
  }
}

// テキストとその装飾 property をまとめて発行する。
// テキストを持てるのは Link と Box である。
fn apply_text_properties(
  id: UiId,
  text: Option[String],
  text_font: Option[String],
  text_size: Option[UiSize],
  text_weight: Option[Uint],
  text_color: Option[Color],
) {
  match text {
    Some(text) => { ui_set_property(id, UiProperty::Text(text)); }
    None => {}
  }
  match text_font {
    Some(text_font) => { ui_set_property(id, UiProperty::TextFont(text_font)); }
    None => {}
  }
  apply_size(id, text_size, fn(v) { UiProperty::TextSize(v) });
  match text_weight {
    Some(text_weight) => { ui_set_property(id, UiProperty::TextWeight(text_weight)); }
    None => {}
  }
  match text_color {
    Some(text_color) => { ui_set_property(id, UiProperty::TextColor(text_color)); }
    None => {}
  }
}

// 子要素をまとめて materialize し、親に積む。
// Horizontal / Vertical / HorizontalGrid / Page で共通する。
fn push_children[S](parent_id: UiId, children: Vec[UiElement[S]]) {
  let i = 0;
  while i < children.len() {
    let child_id = children.get(i).unwrap().materialize();
    ui_push_child(parent_id, child_id);
    i = i + 1;
  }
}

// Biwa 側で組み立てる UI Element の値としての木。
//
// syscall はここでは発行しない。`materialize()` が唯一の消費点であり、
// 木を再帰的に辿って初めて `sys_ui_*` を発行する。
pub enum UiElement[S] {
  Box(Box[S]),
  Link(Link[S]),
  Horizontal(Horizontal[S]),
  Vertical(Vertical[S]),
  HorizontalGrid(HorizontalGrid[S]),
  Image(UiImage[S]),
  Canvas(Canvas[S]),
  MessageArea(MessageArea[S]),
  Layers(Layers[S]),
  SceneStartButton(SceneStartButton[S]),
}

impl[S] UiElement[S] {
  // 木を辿って syscall を発行し、実際に UI Element として出現させる。
  // enum の variant で分岐するのはここ 1 箇所だけである。
  pub(super) fn materialize(self) -> UiId {
    match self {
      UiElement::Box(el) => el.materialize(),
      UiElement::Link(el) => el.materialize(),
      UiElement::Horizontal(el) => el.materialize(),
      UiElement::Vertical(el) => el.materialize(),
      UiElement::HorizontalGrid(el) => el.materialize(),
      UiElement::Image(el) => el.materialize(),
      UiElement::Canvas(el) => el.materialize(),
      UiElement::MessageArea(el) => el.materialize(),
      UiElement::Layers(el) => el.materialize(),
      UiElement::SceneStartButton(el) => el.materialize(),
    }
  }
}

// --- 具体の Element ----------------------------------------------------
//
// struct の定義はここに置き、コンストラクタ・ビルダーメソッド・
// `materialize()` の実装は `game/ui/<element>.biwa` に分けて置く。
// Biwa Language にはまだ pub use 的なエクスポートも visibility も無いため、
// 型の定義自体は同じファイルに集めておく必要がある。
// 将来的には定義自体も `ui/<element>.biwa` に置き、
// `pub import <element>::<Element>;` のような形で公開する見込み。

// ウィンドウ。UI の root となる Element。子は Page のみ持てる。
//
// 型引数 `S` はゲームの状態の型 (`Game[S]` の `S`)。UI の木全体で共有し、
// `main_scene` と `SceneStartButton` の `on_click` の `Game[S]` を揃える。
//
// ノベルゲームとして scene を始められることを保証するもの (`main_scene` / `scene_page`) は
// `Option` にせず、`Window::new` の引数で必ず受け取る。エンジンも、これらが設定されないまま
// Page を積まれたら止める。
//
// ゲーム側の `fn main()` (エントリポイント) がこれを組み立てて `show()` する。
[[lang="ui_window"]]
pub struct Window[S] {
  pages: Vec[Page[S]],
  id: Option[String],
  // scene 本体。`SceneStartButton` が押されると、その `on_click` が作った `Game[S]` でこれが始まる。
  main_scene: Scene[S],
  // scene を映すページ。scene が始まるときに表示され、その Canvas / MessageArea が scene の出力先になる。
  scene_page: ScenePage[S],
}

// ページ。Window の子として、page_id で区別され、Link で遷移できる。
pub struct Page[S] {
  page_id: String,
  children: Vec[UiElement[S]],
  background: Option[Background],
  id: Option[String],
}

// scene を映すページ (`docs/ui-api.md` の改訂版)。Window が 1 つだけ持つ。
//
// Link では遷移できず、`SceneStartButton` が押されて scene が始まるときに表示される。
// レイアウトは Page と同じく子 Element で自由に決める。
//
// scene の出力先 (`canvas` の Canvas API と `message_area` の Content API) は必ず受け取る。
// 受け取るのは配置ではなく ID で、実体 (`Canvas` / `MessageArea`) は子孫として自分で配置する。
// 配置し忘れ・ScenePage の外への配置はエンジンが止める (型では担保できないため)。
pub struct ScenePage[S] {
  canvas: CanvasId,
  message_area: MessageAreaId,
  children: Vec[UiElement[S]],
  background: Option[Background],
  id: Option[String],
}

// 領域を区切る最も基本的な Element。子を 1 つまで持てる (無くてもよい)。
// テキストも持てる (子と両方持つときはテキストが先に並ぶ)。
pub struct Box[S] {
  child: Option[UiElement[S]],
  id: Option[String],
  width: Option[UiSize],
  height: Option[UiSize],
  margin_left: Option[UiSize],
  margin_right: Option[UiSize],
  margin_top: Option[UiSize],
  margin_bottom: Option[UiSize],
  padding_left: Option[UiSize],
  padding_right: Option[UiSize],
  padding_top: Option[UiSize],
  padding_bottom: Option[UiSize],
  background: Option[Background],
  text: Option[String],
  text_font: Option[String],
  text_size: Option[UiSize],
  text_weight: Option[Uint],
  text_color: Option[Color],
}

// 押すと scene を始めるボタン。子は持てない。見た目の property は Link と同じ。
//
// 押されるとホストは `on_click` に `GameWindow` (Window の ScenePage の出力先) を渡して `Game[S]` を作らせ、
// ScenePage を表示してから、その `Game[S]` で Window の `main_scene` を始める。
pub struct SceneStartButton[S] {
  on_click: fn(GameWindow) -> Game[S],
  id: Option[String],
  width: Option[UiSize],
  height: Option[UiSize],
  margin_left: Option[UiSize],
  margin_right: Option[UiSize],
  margin_top: Option[UiSize],
  margin_bottom: Option[UiSize],
  padding_left: Option[UiSize],
  padding_right: Option[UiSize],
  padding_top: Option[UiSize],
  padding_bottom: Option[UiSize],
  background: Option[Background],
  text: Option[String],
  text_font: Option[String],
  text_size: Option[UiSize],
  text_weight: Option[Uint],
  text_color: Option[Color],
}

// リンク。クリックすると同じ Window 内の、指定した page_id を持つ Page に遷移する。
// 子は持てない。テキストを持てる。
pub struct Link[S] {
  on_click_link: String,
  id: Option[String],
  width: Option[UiSize],
  height: Option[UiSize],
  margin_left: Option[UiSize],
  margin_right: Option[UiSize],
  margin_top: Option[UiSize],
  margin_bottom: Option[UiSize],
  padding_left: Option[UiSize],
  padding_right: Option[UiSize],
  padding_top: Option[UiSize],
  padding_bottom: Option[UiSize],
  background: Option[Background],
  text: Option[String],
  text_font: Option[String],
  text_size: Option[UiSize],
  text_weight: Option[Uint],
  text_color: Option[Color],
}

// 子を水平に並べる Layout Element。
pub struct Horizontal[S] {
  children: Vec[UiElement[S]],
  id: Option[String],
  width: Option[UiSize],
  height: Option[UiSize],
  margin_left: Option[UiSize],
  margin_right: Option[UiSize],
  margin_top: Option[UiSize],
  margin_bottom: Option[UiSize],
  padding_left: Option[UiSize],
  padding_right: Option[UiSize],
  padding_top: Option[UiSize],
  padding_bottom: Option[UiSize],
  background: Option[Background],
}

// 子を垂直に並べる Layout Element。
pub struct Vertical[S] {
  children: Vec[UiElement[S]],
  id: Option[String],
  width: Option[UiSize],
  height: Option[UiSize],
  margin_left: Option[UiSize],
  margin_right: Option[UiSize],
  margin_top: Option[UiSize],
  margin_bottom: Option[UiSize],
  padding_left: Option[UiSize],
  padding_right: Option[UiSize],
  padding_top: Option[UiSize],
  padding_bottom: Option[UiSize],
  background: Option[Background],
}

// `column` 本の列に並べ、折り返す Layout Element。
pub struct HorizontalGrid[S] {
  children: Vec[UiElement[S]],
  id: Option[String],
  column: Uint,
  width: Option[UiSize],
  height: Option[UiSize],
  margin_left: Option[UiSize],
  margin_right: Option[UiSize],
  margin_top: Option[UiSize],
  margin_bottom: Option[UiSize],
  padding_left: Option[UiSize],
  padding_right: Option[UiSize],
  padding_top: Option[UiSize],
  padding_bottom: Option[UiSize],
  background: Option[Background],
}

// 画像を表示する Element。子は持てない。
//
// std 上の型名は `UiImage` である。`struct Image` は
// `std::game::image::Image` (canvas に置く画像) が既に使っているため、
// 同じファイルは元より、同じスコープに両方 import すると名前が衝突する
// (Biwa には import のエイリアスが無い)。エンジン側の kind 番号には
// 影響しない、std 側だけの命名判断である。
pub struct UiImage[S] {
  path: String,
  id: Option[String],
  width: Option[UiSize],
  height: Option[UiSize],
  margin_left: Option[UiSize],
  margin_right: Option[UiSize],
  margin_top: Option[UiSize],
  margin_bottom: Option[UiSize],
  padding_left: Option[UiSize],
  padding_right: Option[UiSize],
  padding_top: Option[UiSize],
  padding_bottom: Option[UiSize],
}

// Canvas API の出力先になる Element。子は持てない。
//
// ゲーム進行中の画像などはここに描かれる。`GameCanvas` がこの ui_id を持つ。
// Element として切り出しておくのは、複数キャンバスやミラーリングに備えるため
// (`docs/ui-api.md`)。`Canvas` の名前はもともと `GameCanvas` が使っていたが、
// UI Element の名前に譲った (§14)。
//
// 他の Element と違い、`Canvas::new()` の時点で UI Element を作る (`ui_id` を持つ)。
// `canvas_id()` で ScenePage に出力先として渡すためである。property は他と同じく `materialize` で設定する。
pub struct Canvas[S] {
  ui_id: UiId,
  id: Option[String],
  width: Option[UiSize],
  height: Option[UiSize],
  margin_left: Option[UiSize],
  margin_right: Option[UiSize],
  margin_top: Option[UiSize],
  margin_bottom: Option[UiSize],
  padding_left: Option[UiSize],
  padding_right: Option[UiSize],
  padding_top: Option[UiSize],
  padding_bottom: Option[UiSize],
  background: Option[Background],
}

// Content API (ノベル表現) の出力先になる Element。子は持てない。
//
// scene の生テキストや `$` の埋め込み式はここに出る。`GameMessageArea` がこの ui_id を持つ。
//
// `Canvas` と同じく、`MessageArea::new()` の時点で UI Element を作る (`message_area_id()` のため)。
pub struct MessageArea[S] {
  ui_id: UiId,
  id: Option[String],
  width: Option[UiSize],
  height: Option[UiSize],
  margin_left: Option[UiSize],
  margin_right: Option[UiSize],
  margin_top: Option[UiSize],
  margin_bottom: Option[UiSize],
  padding_left: Option[UiSize],
  padding_right: Option[UiSize],
  padding_top: Option[UiSize],
  padding_bottom: Option[UiSize],
  background: Option[Background],
}

// UI Element の id (エンジンが振る ui_id)。素の `Uint` と取り違えないよう包んである。
// 中身を取り出すのはエンジンとの境界 (`base_engine`) だけである。
pub(super) struct UiId {
  value: Uint,
}

impl UiId {
  pub(super) fn new(value: Uint) -> Self {
    Self { value = value }
  }
  
  pub(super) fn as_raw(self) -> Uint {
    self.value
  }
}

// `ScenePage` の ID。Window に scene を映すページとして結びつける (`UiProperty::WindowScenePage`)。
pub struct ScenePageId {
  ui_id: UiId,
}

impl ScenePageId {
  pub(super) fn new(ui_id: UiId) -> Self {
    Self { ui_id = ui_id }
  }

  pub(super) fn as_raw(self) -> Uint {
    self.ui_id.as_raw()
  }
}

// `Canvas` の ID。ScenePage に scene の Canvas API の出力先として渡す (`Canvas::canvas_id()`)。
//
// 中身は ui_id だが、他の Element の ui_id と取り違えないよう包んである。
// 描画の API を持つ `GameCanvas` (ゲームが始まってから使う出力先) とは役割で分けている。
pub struct CanvasId {
  ui_id: UiId,
}

impl CanvasId {
  pub(super) fn new(ui_id: UiId) -> Self {
    Self { ui_id = ui_id }
  }

  pub(super) fn as_raw(self) -> Uint {
    self.ui_id.as_raw()
  }
}

// `MessageArea` の ID。ScenePage に scene の Content API の出力先として渡す
// (`MessageArea::message_area_id()`)。`GameMessageArea` とは役割で分けている (`CanvasId` と同じ)。
pub struct MessageAreaId {
  ui_id: UiId,
}

impl MessageAreaId {
  pub(super) fn new(ui_id: UiId) -> Self {
    Self { ui_id = ui_id }
  }

  pub(super) fn as_raw(self) -> Uint {
    self.ui_id.as_raw()
  }
}

// 子を重ねる Element (`docs/ui-api.md` の `Layers`)。
//
// 子はそれぞれ Layers の親の中にいるのと同じように配置され、x / y 方向には
// 互いに干渉しない。前後は push された順で決まり、**後から push したものほど上**になる
// (`Layers::new(Vec::of(下)).push(上)`)。背景の Canvas の上にメッセージ枠を重ねる、
// といった用途に使う。
pub struct Layers[S] {
  children: Vec[UiElement[S]],
  id: Option[String],
}
