      i = i + 1;
    }
    
    self.obj
  }
}

// --- 複数のパラメータを一斉に動かすチェーン ---------------------------------
//
// 「かつ」というニュアンスでメソッド名には and が付く。
// 時間は最後の `animate_for()` でまとめて決まるので、
// それまでパラメータごとに 1 つずつ積んでおく。

struct ObjectBatchChain {
  obj: CanvasObject,
  x: Option[CanvasObjectXBatchTransition],
  y: Option[CanvasObjectYBatchTransition],
  w: Option[CanvasObjectWBatchTransition],
  h: Option[CanvasObjectHBatchTransition],
  alpha: Option[CanvasObjectAlphaBatchTransition],
  theta: Option[CanvasObjectThetaBatchTransition],
}

// V: value
// D: difference
enum CanvasObjectBatchTransition[V, D] {
  None,
  Linear(CanvasObjectBatchTransitionOnce[V]),
  EaseIn(CanvasObjectBatchTransitionOnce[V]),
  EaseOut(CanvasObjectBatchTransitionOnce[V]),
  EaseInOut(CanvasObjectBatchTransitionOnce[V]),
  EaseOutIn(CanvasObjectBatchTransitionOnce[V]),
  Sin(CanvasObjectBatchTransitionLoop[D]),
  Triangle(CanvasObjectBatchTransitionLoop[D]),
  Square(CanvasObjectBatchTransitionLoop[D]),
  Saw(CanvasObjectBatchTransitionLoop[D]),
}

struct CanvasObjectBatchTransitionOnce[V] {
  value: V,
}

struct CanvasObjectBatchTransitionLoop[D] {
  diff: D,
  period: Duration,
}

type CanvasObjectXBatchTransition = CanvasObjectBatchTransition[Cx, Cw];
type CanvasObjectYBatchTransition = CanvasObjectBatchTransition[Cy, Ch];
type CanvasObjectWBatchTransition = CanvasObjectBatchTransition[Cw, Cw];
type CanvasObjectHBatchTransition = CanvasObjectBatchTransition[Ch, Ch];
type CanvasObjectAlphaBatchTransition = CanvasObjectBatchTransition[Alpha, Alpha];
type CanvasObjectThetaBatchTransition = CanvasObjectBatchTransition[Theta, Theta];

impl[V, D] CanvasObjectBatchTransition[V, D] {
  fn as_transition(self, duration: Duration) -> CanvasObjectTransition[V, D] {
    match self {
      CanvasObjectBatchTransition::None => CanvasObjectTransition::None,
      CanvasObjectBatchTransition::Linear(once) => CanvasObjectTransition::Linear(once.as_transition_once(duration)),
      CanvasObjectBatchTransition::EaseIn(once) => CanvasObjectTransition::EaseIn(once.as_transition_once(duration)),
      CanvasObjectBatchTransition::EaseOut(once) => CanvasObjectTransition::EaseOut(once.as_transition_once(duration)),
      CanvasObjectBatchTransition::EaseInOut(once) => CanvasObjectTransition::EaseInOut(once.as_transition_once(duration)),
      CanvasObjectBatchTransition::EaseOutIn(once) => CanvasObjectTransition::EaseOutIn(once.as_transition_once(duration)),
      CanvasObjectBatchTransition::Sin(lo) => CanvasObjectTransition::Sin(lo.as_transition_loop(duration)),
      CanvasObjectBatchTransition::Triangle(lo) => CanvasObjectTransition::Triangle(lo.as_transition_loop(duration)),
      CanvasObjectBatchTransition::Square(lo) => CanvasObjectTransition::Square(lo.as_transition_loop(duration)),
      CanvasObjectBatchTransition::Saw(lo) => CanvasObjectTransition::Saw(lo.as_transition_loop(duration)),
    }
  }
}

impl[V] CanvasObjectBatchTransitionOnce[V] {
  fn as_transition_once(self, duration: Duration) -> CanvasObjectTransitionOnce[V] {
    CanvasObjectTransitionOnce {
      value = self.value,
      duration = duration,
    }
  }
}

impl[D] CanvasObjectBatchTransitionLoop[D] {
  fn as_transition_loop(self, duration: Duration) -> CanvasObjectTransitionLoop[D] {
    CanvasObjectTransitionLoop {
      value = self.value,
      period = self.period,
      continuity = CanvasObjectTransitionContinuity::For(duration),
    }
  }
}


impl ObjectBatchChain {
  fn new(obj: CanvasObject) -> Self {
    Self {
      obj = obj,
      x = None,
      y = None,
      w = None,
      h = None,
      alpha = None,
      theta = None,
    }
  }

  // pub
  fn x_move_and(self, x: Cx) -> Self {
    self.x = Some(
      CanvasObjectXBatchTransition::Linear(CanvasObjectBatchTransitionOnce {
        value = x,
      }));
  
    self
  }

  // pub
  fn y_move_and(self, y: Cy) -> Self {
    self.y = Some(
      CanvasObjectYBatchTransition::Linear(CanvasObjectBatchTransitionOnce {
        value = y,
      }));
  }

  // pub
  fn x_easein_and(self, x: Cx) -> Self {
    self.x = Some(
      CanvasObjectXBatchTransition::EaseIn(CanvasObjectBatchTransitionOnce {
        value = x,
      }));
  
    self
  }

  // pub
  fn x_easeout_and(self, x: Cx) -> Self {
    self.x = Some(
      CanvasObjectXBatchTransition::EaseOut(CanvasObjectBatchTransitionOnce {
        value = x,
      }));
  
    self
  }

  // pub
  fn y_easein_and(self, y: Cy) -> Self {
    self.y = Some(
      CanvasObjectYBatchTransition::EaseIn(CanvasObjectBatchTransitionOnce {
        value = y,
      }));

    self
  }

  // pub
  fn y_easeout_and(self, y: Cy) -> Self {
    self.y = Some(
      CanvasObjectYBatchTransition::EaseOut(CanvasObjectBatchTransitionOnce {
        value = y,
      }));
  
    self
  }

  // pub
  fn w_resize_and(self, w: Cw) -> Self {
    self.w = Some(
      CanvasObjectWBatchTransition::Linear(CanvasObjectBatchTransitionOnce {
        value = w,
      }));
  
    self
  }

  // pub
  fn h_resize_and(self, h: Ch) -> Self {
    self.h = Some(
      CanvasObjectHBatchTransition::Linear(CanvasObjectBatchTransitionOnce {
        value = h,
      }));
  
    self
  }

  // pub
  fn fade_to_and(self, alpha: Alpha) -> Self {
    self.alpha = Some(
      CanvasObjectAlphaBatchTransition::Linear(CanvasObjectBatchTransitionOnce {
        value = alpha,
      }));
  
    self
  }

  // pub
  fn be_visible_and(self) -> Self {
    self.fade_to_and(Alpha::opaque())
  }

  // pub
  fn be_invisible_and(self) -> Self {
    self.fade_to_and(Alpha::transparent())
  }

  // pub
  fn rotate_and(self, theta: Theta) -> Self {
    self.theta = Some(
      CanvasObjectThetaBatchTransition::Linear(CanvasObjectBatchTransitionOnce {
        value = theta,
      }));
  
    self
  }

  // pub
  fn x_sin_and(self, amplitude: Cx, period: Duration) -> Self {
    self.x = Some(
      CanvasObjectXBatchTransition::Sin(CanvasObjectBatchTransitionLoop {
        diff = amplitude,
        period = period,
      }));
  
    self
  }

  // pub
  fn y_sin_and(self, amplitude: Cy, period: Duration) -> Self {
    self.y = Some(
      CanvasObjectYBatchTransition::Sin(CanvasObjectBatchTransitionLoop {
        diff = amplitude,
        period = period,
      }));
  
    self
  }

  // pub
  fn theta_sin_and(self, amplitude: Theta, period: Duration) -> Self {
    self.theta = Some(
      CanvasObjectThetaBatchTransition::Sin(CanvasObjectBatchTransitionLoop {
        diff = amplitude,
        period = period,
      }));
  
    self
  }

  // 積んだものを `duration` かけて一斉に動かす。
  // 周期系はその周期で揺れ、`duration` 経ったところで止まる。
  // pub
  fn animate_for(self, duration: Duration) -> CanvasObject {
    self.stage(duration);
    package::game::base_engine::start_transitions(CanvasObjectTransitionSyncMode::Sync);
    
    self.obj
  }

  // pub
  fn animate_free_for(self, duration: Duration) -> CanvasObject {
    self.stage(duration);
    package::game::base_engine::start_transitions(CanvasObjectTransitionSyncMode::Free);
    
    self.obj
  }

  fn stage(self, duration: Duration) {
    match self.x {
      Some(batch_transition) => {
        package::game::base_engine::add_x_transition(
          self.obj.id, 
          batch_transition.as_transition(duration),
          Duration::ms(0));
      },
      None => {},
    }
      
    // TODO:
    // y, w, h, alpha, theta
  }
}

// canvas 上の位置
// pub
struct Position {
  x: Cx,
  y: Cy,
}
