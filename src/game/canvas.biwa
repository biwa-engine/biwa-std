// canvas 上の座標と大きさ。
//
// 出力先の Canvas (UI Element) を基準にした単位で表す。
//
// - 原点は canvas の中央。x は右が正、y は上が正。
// - x / y は **canvas の範囲が -50.0 から 50.0** になる単位
//   (x は canvas の幅、y は canvas の高さに対する割合)。
// - 幅 / 高さも同じ単位で、100.0 が canvas の幅 / 高さそのもの。
//   片方だけ Auto なら画像の縦横比を保つように、
//   両方 Auto なら画像の元の大きさ (px) になるように、エンジンが表示。
//
// 中身は Float だが、canvas の座標・大きさは syscall を直接呼ぶ所以外ではすべてこの型で扱う。
// 作るときは `cx(10.0)` のように初期化関数を使う (`vw()` / `vh()` と同じく import して使う)。

import package::convert::Into;
import package::option::Option;
import package::option::Option::Some;
import package::option::Option::None;
import package::collections::Vec;
import package::time::Duration;
import package::game::color::Alpha;
import package::game::ui::GameCanvas;
import package::game::image::Image;

// canvas 上の x 座標。
struct Cx {
  value: Float,
}

// canvas 上の y 座標。
struct Cy {
  value: Float,
}

// canvas 上の幅。
enum Cw {
  Auto,
  Configured(Float),
}

// canvas 上の高さ。
enum Ch {
  Auto,
  Configured(Float),
}

// canvas 上の回転角度
struct Theta {
  value: Float,
}

impl Cx {
  fn cx(value: Float) -> Self { Self { value = value } }
}

impl Cx: Into[Float] {
  fn into(self) -> Float {
    self.value
  }
}

impl Cy {
  fn cy(value: Float) -> Self { Self { value = value } }
}

impl Cy: Into[Float] {
  fn into(self) -> Float {
    self.value
  }
}

impl Cw {
  fn cw(value: Float) -> Self { Cw::Configured(value) }
}

impl Cw: Into[Float] {
  fn into(self) -> Float {
    match self {
      Cw::Auto => -1.0,
      Cw::Configured(value) => value,
    }
  }
}

impl Ch {
  fn ch(value: Float) -> Self { Ch::Configured(value) }
}

impl Ch: Into[Float] {
  fn into(self) -> Float {
    match self {
      Ch::Auto => -1.0,
      Ch::Configured(value) => value,
    }
  }
}

impl Theta {
  fn theta(value: Float) -> Self { Self { value = value } }

  fn add(self, rhs: Self) -> Self { Self { value = self.value + rhs.value } }

  fn sub(self, rhs: Self) -> Self { Self { value = self.value - rhs.value } }
}

impl Theta: Into[Float] {
  fn into(self) -> Float {
    self.value
  }
}

enum CanvasObjectParam {
  X, 
  Y, 
  W, 
  H, 
  Alpha,
  Theta,
}

enum CanvasObjectTransitionSyncMode {
  Free,
  Sync,
}

// V: value
// D: difference
enum CanvasObjectTransition[V, D] {
  None,
  Linear(CanvasObjectTransitionOnce[V]),
  EaseIn(CanvasObjectTransitionOnce[V]),
  EaseOut(CanvasObjectTransitionOnce[V]),
  EaseInOut(CanvasObjectTransitionOnce[V]),
  EaseOutIn(CanvasObjectTransitionOnce[V]),
  Sin(CanvasObjectTransitionLoop[D]),
  Triangle(CanvasObjectTransitionLoop[D]),
  Square(CanvasObjectTransitionLoop[D]),
  Saw(CanvasObjectTransitionLoop[D]),
}

struct CanvasObjectTransitionOnce[V] {
  value: V,
  duration: Duration,
}

struct CanvasObjectTransitionLoop[D] {
  diff: D,
  period: Duration,
  continuity: CanvasObjectTransitionContinuity,
}

enum CanvasObjectTransitionContinuity {
  Infinite,
  For(Duration),
}

// チェーンに積んだ遷移 1 つと、その開始時刻 (`animate()` 系で発火してからの遅れ)。
struct CanvasObjectScheduledTransition[V, D] {
  after: Duration,
  transition: CanvasObjectTransition[V, D],
}

type CanvasObjectXTransition = CanvasObjectTransition[Cx, Cw];
type CanvasObjectYTransition = CanvasObjectTransition[Cy, Ch];
type CanvasObjectWTransition = CanvasObjectTransition[Cw, Cw];
type CanvasObjectHTransition = CanvasObjectTransition[Ch, Ch];
type CanvasObjectAlphaTransition = CanvasObjectTransition[Alpha, Alpha];
type CanvasObjectThetaTransition = CanvasObjectTransition[Theta, Theta];

// --- canvas 上のオブジェクト -----------------------------------------------

// エンジンに置かれたオブジェクトへのハンドル。常に canvas 上に実在する
// (作るときに `create_object` syscall を呼ぶ)。無いことを表すなら外側で `Option` を使う。
//
// 遷移を積んで発火するのはチェーン (`x_then()` / `and()`) の仕事で、
// ここが持つのは置き場所と、積んだ遷移の目標値だけである。
//
// - `x`..`theta`: 発火した遷移の目標値。つまり**アニメーション後の値**。
//   動いている画像の「今の位置」はエンジンからは取れないので、
//   立ち絵の差し替え (`Character::change_visual`) ではこれを使う。
//   チェーンが `animate()` 系で発火するときに書き込む。
struct CanvasObject {
  id: Uint,
  // 置いた先の Canvas。差し替え (`Character::change_visual`) で同じ所に出し直すのに使う。
  canvas: GameCanvas,
  layer: Uint,
  x: Cx,
  y: Cy,
  w: Cw,
  h: Ch,
  alpha: Alpha,
  theta: Theta,
}

impl CanvasObject {
  fn create(
    image: Image, canvas: GameCanvas, layer: Uint, x: Cx, y: Cy, w: Cw, h: Ch, alpha: Alpha,
  ) -> Self {
    let id = package::game::base_engine::create_object(
      canvas.ui_id, image.path, layer, x, y, w, h, alpha, Theta::theta(0.0));

    Self {
      id = id,
      canvas = canvas,
      layer = layer,
      x = x,
      y = y,
      w = w,
      h = h,
      alpha = alpha,
      theta = Theta::theta(0.0),
    }
  }

  // pub
  fn delete(self, after: Duration) {
    package::game::base_engine::delete_object(self.id, after);
  }

  // --- チェーンの入口 ---
  //
  // 複数のパラメータを同じ時間で一斉に動かすときは `and()`。
  // 1 つのパラメータを連続して動かすときは `*_then()`。
  // どちらも `animate()` 系を呼ぶまで何も起きない (syscall も発行しない)。

  // pub
  fn and(self) -> ObjectBatchChain {
    ObjectBatchChain::new(self)
  }

  // pub
  fn x_then(self) -> ObjectParamXChain {
    ObjectParamXChain::new(self)
  }

  // pub
  fn y_then(self) -> ObjectParamYChain {
    ObjectParamYChain::new(self)
  }

  // pub
  fn w_then(self) -> ObjectParamWChain {
    ObjectParamWChain::new(self)
  }

  // pub
  fn h_then(self) -> ObjectParamHChain {
    ObjectParamHChain::new(self)
  }

  // pub
  fn alpha_then(self) -> ObjectParamAlphaChain {
    ObjectParamAlphaChain::new(self)
  }

  // pub
  fn theta_then(self) -> ObjectParamThetaChain {
    ObjectParamThetaChain::new(self)
  }
}

// --- 1 つのパラメータを連続して動かすチェーン -------------------------------
//
// 「それから」というニュアンスでメソッド名には then が付く。
// 遷移は `animate()` / `animate_free()` を呼ぶまでチェーンに貯めておくだけで、
// 呼んだときにまとめて `add_transition` / `start_transitions` syscall を発行する。
// 途中で `animate()` せずに捨てたチェーンの遷移は発火しない
// (別のオブジェクトのチェーンの `animate()` に巻き込まれることも無い)。
//
// V: そのパラメータの値の型、D: 揺れ幅 (差分) の型。パラメータごとに型が決まっている
// (`ObjectParamXChain` は `Cx` / `Cw` しか受け取らない)。

struct ObjectParamChain[V, D] {
  obj: CanvasObject,
  // 積んだ遷移。先頭から順に、それぞれの開始時刻で始まる。
  transitions: Vec[CanvasObjectScheduledTransition[V, D]],
  // 次に積む遷移の開始時刻。前の遷移が終わる時刻である。
  after: Duration,
  // 最後に積んだ一度限りの遷移の目標値。発火したら `obj` に書き込む。
  target: Option[V],
}

type ObjectParamXChain = ObjectParamChain[Cx, Cw];
type ObjectParamYChain = ObjectParamChain[Cy, Ch];
type ObjectParamWChain = ObjectParamChain[Cw, Cw];
type ObjectParamHChain = ObjectParamChain[Ch, Ch];
type ObjectParamAlphaChain = ObjectParamChain[Alpha, Alpha];
type ObjectParamThetaChain = ObjectParamChain[Theta, Theta];

impl[V, D] ObjectParamChain[V, D] {
  fn new(obj: CanvasObject) -> Self {
    Self {
      obj = obj,
      transitions = Vec::new(),
      after = Duration::ms(0),
      target = None,
    }
  }

  // 遷移を今の開始時刻で積み、開始時刻を `advance` だけ進める。
  fn push(self, transition: CanvasObjectTransition[V, D], advance: Duration) {
    self.transitions.push(CanvasObjectScheduledTransition {
      after = self.after,
      transition = transition,
    });
    self.after = self.after.add(advance);
  }

  fn push_once(self, transition: CanvasObjectTransition[V, D], value: V, duration: Duration) -> Self {
    self.push(transition, duration);
    self.target = Some(value);
    self
  }

  // pub
  fn linear_then(self, value: V, duration: Duration) -> Self {
    self.push_once(
      CanvasObjectTransition::Linear(CanvasObjectTransitionOnce { value = value, duration = duration }),
      value, duration)
  }

  // pub
  fn easein_then(self, value: V, duration: Duration) -> Self {
    self.push_once(
      CanvasObjectTransition::EaseIn(CanvasObjectTransitionOnce { value = value, duration = duration }),
      value, duration)
  }

  // pub
  fn easeout_then(self, value: V, duration: Duration) -> Self {
    self.push_once(
      CanvasObjectTransition::EaseOut(CanvasObjectTransitionOnce { value = value, duration = duration }),
      value, duration)
  }

  // pub
  fn easeinout_then(self, value: V, duration: Duration) -> Self {
    self.push_once(
      CanvasObjectTransition::EaseInOut(CanvasObjectTransitionOnce { value = value, duration = duration }),
      value, duration)
  }

  // pub
  fn easeoutin_then(self, value: V, duration: Duration) -> Self {
    self.push_once(
      CanvasObjectTransition::EaseOutIn(CanvasObjectTransitionOnce { value = value, duration = duration }),
      value, duration)
  }

  // `until` の間だけ揺らす。多くの場合は終わりを決めたいのでこちらを使う。
  // pub
  fn sin_then(self, amplitude: D, period: Duration, until: Duration) -> Self {
    self.push(
      CanvasObjectTransition::Sin(CanvasObjectTransitionLoop {
        diff = amplitude,
        period = period,
        continuity = CanvasObjectTransitionContinuity::For(until),
      }),
      until);
    self
  }

  // 止めずに揺らし続ける。次に同じパラメータを駆動するまで続く。
  // pub
  fn sin_forever(self, amplitude: D, period: Duration) -> Self {
    self.push(
      CanvasObjectTransition::Sin(CanvasObjectTransitionLoop {
        diff = amplitude,
        period = period,
        continuity = CanvasObjectTransitionContinuity::Infinite,
      }),
      Duration::ms(0));
    self
  }

  // その時点でそのパラメータの遷移を止める。
  // pub
  fn stop_then(self) -> Self {
    self.push(CanvasObjectTransition::None, Duration::ms(0));
    self
  }

  // 次の遷移までの間を空ける。
  // pub
  fn sleep_then(self, duration: Duration) -> Self {
    self.after = self.after.add(duration);
    self
  }
}

// 発火 (`animate()` / `animate_free()`) はパラメータごとに書く。
// 積んだ遷移を出す syscall も、目標値を書き込む先 (`obj.x` など) もパラメータで違うためである。
// テキストと同期する演出として発火するのが `animate()`、
// テキストとは無関係に走らせる (クリックでは飛ばない) のが `animate_free()`。

impl ObjectParamXChain {
  fn submit(self) {
    let i = 0;
    while i < self.transitions.len() {
      let scheduled = self.transitions.get(i).unwrap();
      package::game::base_engine::add_x_transition(
        self.obj.id, scheduled.transition, scheduled.after);
      i = i + 1;
    }
    match self.target {
      Some(value) => { self.obj.x = value; },
      None => {},
    }
  }

  // pub
  fn animate(self) -> CanvasObject {
    self.submit();
    package::game::base_engine::start_transitions(CanvasObjectTransitionSyncMode::Sync);
    self.obj
  }

  // pub
  fn animate_free(self) -> CanvasObject {
    self.submit();
    package::game::base_engine::start_transitions(CanvasObjectTransitionSyncMode::Free);
    self.obj
  }
}

impl ObjectParamYChain {
  fn submit(self) {
    let i = 0;
    while i < self.transitions.len() {
      let scheduled = self.transitions.get(i).unwrap();
      package::game::base_engine::add_y_transition(
        self.obj.id, scheduled.transition, scheduled.after);
      i = i + 1;
    }
    match self.target {
      Some(value) => { self.obj.y = value; },
      None => {},
    }
  }

  // pub
  fn animate(self) -> CanvasObject {
    self.submit();
    package::game::base_engine::start_transitions(CanvasObjectTransitionSyncMode::Sync);
    self.obj
  }

  // pub
  fn animate_free(self) -> CanvasObject {
    self.submit();
    package::game::base_engine::start_transitions(CanvasObjectTransitionSyncMode::Free);
    self.obj
  }
}

impl ObjectParamWChain {
  fn submit(self) {
    let i = 0;
    while i < self.transitions.len() {
      let scheduled = self.transitions.get(i).unwrap();
      package::game::base_engine::add_w_transition(
        self.obj.id, scheduled.transition, scheduled.after);
      i = i + 1;
    }
    match self.target {
      Some(value) => { self.obj.w = value; },
      None => {},
    }
  }

  // pub
  fn animate(self) -> CanvasObject {
    self.submit();
    package::game::base_engine::start_transitions(CanvasObjectTransitionSyncMode::Sync);
    self.obj
  }

  // pub
  fn animate_free(self) -> CanvasObject {
    self.submit();
    package::game::base_engine::start_transitions(CanvasObjectTransitionSyncMode::Free);
    self.obj
  }
}

impl ObjectParamHChain {
  fn submit(self) {
    let i = 0;
    while i < self.transitions.len() {
      let scheduled = self.transitions.get(i).unwrap();
      package::game::base_engine::add_h_transition(
        self.obj.id, scheduled.transition, scheduled.after);
      i = i + 1;
    }
    match self.target {
      Some(value) => { self.obj.h = value; },
      None => {},
    }
  }

  // pub
  fn animate(self) -> CanvasObject {
    self.submit();
    package::game::base_engine::start_transitions(CanvasObjectTransitionSyncMode::Sync);
    self.obj
  }

  // pub
  fn animate_free(self) -> CanvasObject {
    self.submit();
    package::game::base_engine::start_transitions(CanvasObjectTransitionSyncMode::Free);
    self.obj
  }
}

impl ObjectParamAlphaChain {
  fn submit(self) {
    let i = 0;
    while i < self.transitions.len() {
      let scheduled = self.transitions.get(i).unwrap();
      package::game::base_engine::add_alpha_transition(
