// ゲームの設定
// configuration of the game.
//
// `Window` に与え (`Window::config`)、`WindowHandle` が持つ。`Game` は `WindowHandle` 経由でこれを読む。
// 設定はプレイをまたいで (Window の寿命で) 続くものなので、`Game` ではなく Window の側に置いている。
// struct は参照なので、`UserConfig` を書き換えれば、同じ Window を指すすべての持ち主から変わって見える。

import package::game::color::Color;
import package::game::ui::Size;
import package::game::content::ContentSpeed;
import package::option::Option;
import package::option::Option::Some;
import package::game::sound::VolumeConfig;
import package::game::sound::Ducking;

pub struct Config {
  // 開発者によって設定されるconfig
  // ビルド時に固定される種類の値を格納
  dev: DeveloperConfig,
  
  // ユーザ(プレイヤー)によって実行時に変更されうるconfig
  user: UserConfig,
}

pub struct DeveloperConfig {
  // window の mode
  // *Only にすると、設定していない方のモードに変更しようとするAPIが発行されても
  // 無視される
  mode: WindowMode,

  // 開発者によって設定されるデフォルトの文字速度
  // [text per sec]
  default_content_speed: ContentSpeed,

  // 開発者によって設定されるデフォルトの文字サイズ
  default_content_size: Size,

  // 開発者によって設定されるデフォルトの文字色
  default_text_color: Color,

  // 開発者によって設定されるデフォルトの音量 (バスごと)。プレイヤーの設定の初期値になる。
  default_volumes: VolumeConfig,

  // ボイスが鳴る間 BGM を下げるか (None なら下げない)。
  bgm_ducking: Option[Ducking],
}

pub(super) struct UserConfig {
  // ユーザによって動的に設定された文字速度
  // デフォルト値は DeveloperConfig.default_content_speed 
  content_speed: ContentSpeed,
  
  // ユーザによって動的に設定された文字サイズ
  // デフォルト値は DeveloperConfig.default_content_size 
  content_size: Size,

  // ユーザによって設定された音量。デフォルト値は DeveloperConfig.default_volumes
  volumes: VolumeConfig,

  // `>>` でボイスを止めずに続けるか。
  voice_continues: Bool,
}

pub enum WindowMode {
  Both,
  AdventureOnly,
  VisualNovelOnly,
}

impl Config {
  pub(super) fn dev(self) -> DeveloperConfig {
    self.dev
  }

  pub(super) fn user(self) -> UserConfig {
    self.user
  }

  // `DeveloperConfig::default()` から作った設定。`Window` に設定を与えなかったときはこれになる。
  pub fn default() -> Self {
    Config::new(DeveloperConfig::default())
  }

  pub fn new(dev: DeveloperConfig) -> Self {
    Self {
      dev = dev,
      user = UserConfig {
        content_speed = dev.default_content_speed,
        content_size = dev.default_content_size,
        volumes = dev.default_volumes,
        voice_continues = FALSE,
      },
    }
  }
}

impl DeveloperConfig {
  pub(super) fn default_text_color(self) -> Color {
    self.default_text_color
  }

  pub fn default() -> Self {
    Self {
      mode = WindowMode::Both,
      default_content_speed = ContentSpeed::text_per_sec(30.0),
      default_content_size = Size::Vh(2.0),
      default_text_color = Color::white(),
      default_volumes = VolumeConfig::default(),
      bgm_ducking = Some(Ducking::default()),
    }
  }

  pub fn new(
    mode: WindowMode,
    default_content_speed: ContentSpeed,
    default_content_size: Size,
    default_text_color: Color
  ) -> Self {
    Self {
      mode = mode,
      default_content_speed = default_content_speed,
      default_content_size = default_content_size,
      default_text_color = default_text_color,
      default_volumes = VolumeConfig::default(),
      bgm_ducking = Some(Ducking::default()),
    }
  }

  pub(package) fn bgm_ducking(self) -> Option[Ducking] {
    self.bgm_ducking
  }

  // デフォルトの音量を変える。
  pub fn with_volumes(self, v: VolumeConfig) -> Self {
    self.default_volumes = v;
    self
  }

  // ボイスが鳴る間の BGM の下げ方を変える (None なら下げない)。
  pub fn with_bgm_ducking(self, d: Option[Ducking]) -> Self {
    self.bgm_ducking = d;
    self
  }
}

impl UserConfig {
  pub(super) fn content_speed(self) -> ContentSpeed {
    self.content_speed
  }

  pub(super) fn content_size(self) -> Size {
    self.content_size
  }

  pub(package) fn volumes(self) -> VolumeConfig {
    self.volumes
  }

  pub(package) fn set_volumes(self, v: VolumeConfig) {
    self.volumes = v;
  }

  pub(package) fn voice_continues(self) -> Bool {
    self.voice_continues
  }

  pub(package) fn set_voice_continues(self, value: Bool) {
    self.voice_continues = value;
  }
}
