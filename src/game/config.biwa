// Game に与える設定
// configuration given to `struct Game`.

import package::game::color::Color;
import package::game::ui::Size;
import package::game::content::ContentSpeed;

pub struct Config {
  // 開発者によって設定されるconfig
  // ビルド時に固定される種類の値を格納
  dev: DeveloperConfig,
  
  // ユーザ(プレイヤー)によって実行時に変更されうるconfig
  user: UserConfig,
}

pub struct DeveloperConfig {
  // window の mode
  // *Only にすると、設定していない方のモードに変更しようとするAPIが発行されても
  // 無視される
  mode: WindowMode,

  // 開発者によって設定されるデフォルトの文字速度
  // [text per sec]
  default_content_speed: ContentSpeed,

  // 開発者によって設定されるデフォルトの文字サイズ
  default_content_size: Size,

  // 開発者によって設定されるデフォルトの文字色
  default_text_color: Color,
}

pub(super) struct UserConfig {
  // ユーザによって動的に設定された文字速度
  // デフォルト値は DeveloperConfig.default_content_speed 
  content_speed: ContentSpeed,
  
  // ユーザによって動的に設定された文字サイズ
  // デフォルト値は DeveloperConfig.default_content_size 
  content_size: Size,
}

pub enum WindowMode {
  Both,
  AdventureOnly,
  VisualNovelOnly,
}

impl Config {
  pub(super) fn dev(self) -> DeveloperConfig {
    self.dev
  }

  pub(super) fn user(self) -> UserConfig {
    self.user
  }

  pub fn new(dev: DeveloperConfig) -> Self {
    Self {
      dev = dev,
      user = UserConfig {
        content_speed = dev.default_content_speed,
        content_size = dev.default_content_size,
      },
    }
  }
}

impl DeveloperConfig {
  pub(super) fn default_text_color(self) -> Color {
    self.default_text_color
  }

  pub fn default() -> Self {
    Self {
      mode = WindowMode::Both,
      default_content_speed = ContentSpeed::text_per_sec(30.0),
      default_content_size = Size::Vh(2.0),
      default_text_color = Color::white(),
    }
  }

  pub fn new(
    mode: WindowMode,
    default_content_speed: ContentSpeed,
    default_content_size: Size,
    default_text_color: Color
  ) -> Self {
    Self {
      mode = mode,
      default_content_speed = default_content_speed,
      default_content_size = default_content_size,
      default_text_color = default_text_color,
    }
  }
}

impl UserConfig {
  pub(super) fn content_speed(self) -> ContentSpeed {
    self.content_speed
  }

  pub(super) fn content_size(self) -> Size {
    self.content_size
  }
}
