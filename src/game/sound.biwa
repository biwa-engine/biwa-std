// 音 (BGM・SE・環境音・ボイス)。仕様は `docs/sound.md`。
//
// - `Sound` は音のファイル 1 つと、その鳴らし方の既定 (音量・位置・ループの区間)。syscall を出さない値である。
// - `SoundObject` は再生 1 回。`bus.play(sound, playback)` で作られたときには鳴り始めている。
// - 音はバス (`Bus`) を通る。バスは木で、音量と effect の列を持つ。根 (master) だけが出力に繋がる。
// - 音量はすべて dB (`Volume`)。経路に沿って足し算になる。-60 dB 以下は無音。
// - 位置 (`SoundPosition`) は x (左右) と y (前後) の 2 軸で、どちらも -1.0..1.0。ステレオでは y は捨てられる。
// - 開始・停止・変化は canvas の遷移と同じく、タイムラインに積んでから発火する (`std::game::timeline`)。
//
// **作ったものは作った時点で完成している。** バスは親・音量・effect の列を一度に受け取って木に繋がった状態で返り、
// effect は必要な値をすべて受け取って作られる。後から「挿す」「繋ぐ」「設定する」中途半端な状態は無い。
//
// 既定の木 (`SoundBuses::standard()`) は Window の寿命のもので、`WindowHandle` が `Game` に運ぶ。
// ゲームからは `g.play_se(..)` / `g.change_bgm(..)` / `g.sound().buses().se()` のように使う。

import package::string::String;
import package::option::Option;
import package::option::Option::Some;
import package::option::Option::None;
import package::collections::Vec;
import package::time::Duration;
import package::game::Game;
import package::game::config::Config;
import package::game::timeline::TimelineSync;
import package::game::timeline::Transition;
import package::game::runtime;

// --- 量 -----------------------------------------------------------------------

// 音量。dB (デシベル) で持つ。0 dB は「そのまま」、-6 dB はおよそ半分の振幅。-60 dB 以下は無音。
pub struct Volume {
  db: Float,
}

impl Volume {
  pub fn db(db: Float) -> Self {
    Self { db = db }
  }

  // プレイヤーの設定画面のような 0〜100 の値。`40 * log10(p / 100)` dB に直す
  // (100 → 0 dB、50 → -12 dB、25 → -24 dB、10 → -40 dB、0 → 無音)。
  pub fn percent(p: Uint) -> Self {
    if p == 0 {
      Volume::silent()
    } else {
      let ratio = runtime::uint_to_float(p) / 100.0;
      Self { db = 40.0 * log10(ratio) }
    }
  }

  // 無音 (-60 dB)。フェードの端点にも使う。
  pub fn silent() -> Self {
    Self { db = -60.0 }
  }

  pub fn as_db(self) -> Float {
    self.db
  }
}

// 周波数。`hz(440.0)` のように作る (`cx()` / `vw()` と同じく import して使う)。
// 補間は対数の上で行われる (1000 → 2000 Hz と 2000 → 4000 Hz は同じ速さに聞こえる)。
pub struct Hz {
  value: Float,
}

impl Hz {
  pub fn hz(value: Float) -> Self {
    Self { value = value }
  }

  pub fn as_hz(self) -> Float {
    self.value
  }
}

// compressor の圧縮比。`CompressionRatio::new(4.0)` は 4:1 (threshold を超えた分を 1/4 にする)。1.0 は圧縮しない。
pub struct CompressionRatio {
  ratio: Float,
}

impl CompressionRatio {
  pub fn new(ratio: Float) -> Self {
    Self { ratio = ratio }
  }

  pub fn as_ratio(self) -> Float {
    self.ratio
  }
}

// 音の位置。x は -1.0 (左) 〜 1.0 (右)、y は -1.0 (後ろ) 〜 1.0 (前)。
// canvas の座標 (-50..50) とは別の量である (画面の中の場所ではなく、スピーカに対する方向)。
pub struct SoundPosition {
  x: Float,
  y: Float,
}

impl SoundPosition {
  pub fn center() -> Self { Self { x = 0.0, y = 0.0 } }
  pub fn left() -> Self { Self { x = -1.0, y = 0.0 } }
  pub fn right() -> Self { Self { x = 1.0, y = 0.0 } }
  pub fn at(x: Float, y: Float) -> Self { Self { x = x, y = y } }
  pub fn x(self) -> Float { self.x }
  pub fn y(self) -> Float { self.y }
}

// ループの区間。2 回目以降は `start` から鳴る。`end` が None ならファイルの終わりまで。
pub struct SoundLoopRange {
  start: Duration,
  end: Option[Duration],
}

impl SoundLoopRange {
  // BGM の前奏を飛ばして繰り返すときなど。
  pub fn new(start: Duration, end: Option[Duration]) -> Self {
    Self { start = start, end = end }
  }

  // ファイル全体を繰り返す。
  pub fn whole() -> Self {
    Self { start = Duration::ms(0), end = None }
  }

  pub(super) fn start(self) -> Duration { self.start }
  pub(super) fn end(self) -> Option[Duration] { self.end }
}

// 何回鳴らすか。
pub enum SoundRepetition {
  // 止めるまで繰り返す (BGM・環境音)。
  Infinite,
  // n 回通して終わる (SE・ボイス)。
  Count(Uint),
}

// ラウドネス正規化 (ファイルごとの音の大きさの違いを揃える) をするか。
pub enum Loudness {
  // そのまま鳴らす。SE は大小を意図して付けていることが多いので、こちら。
  AsIs,
  // 揃える。BGM とボイス。**段 2 で実装する** (それまでは AsIs と同じ)。
  Normalize,
}

// --- Sound と SoundObject -----------------------------------------------------

// 音のファイル 1 つと、その鳴らし方の既定。syscall を出さない (鳴らすまで何も起きない)。
// パスはパッケージの `assets/` 基準の相対パス。形式は MP3・WAV (PCM)・Ogg Vorbis (`docs/sound.md` の Tier)。
pub struct Sound {
  path: String,
  volume: Volume,
  position: SoundPosition,
  loop_range: SoundLoopRange,
}

impl Sound {
  pub fn new(path: String, volume: Volume, position: SoundPosition, loop_range: SoundLoopRange) -> Self {
    Self { path = path, volume = volume, position = position, loop_range = loop_range }
  }

  // 0 dB・中央・ファイル全体をループの区間とする。
  pub fn file(path: String) -> Self {
    Sound::new(path, Volume::db(0.0), SoundPosition::center(), SoundLoopRange::whole())
  }

  // 読み込みを先に始めておく (最初に鳴らすときに待たないように)。
  pub fn preload(self) {
    runtime::sound::sound_preload(self.path);
  }

  pub(package) fn path(self) -> String {
    self.path
  }
}

// 鳴らし方 (再生 1 回ごとに決めるもの)。
pub struct SoundPlayback {
  repetition: SoundRepetition,
  // ファイルのどこから鳴らし始めるか。
  offset: Duration,
  // あれば、無音から `Sound` の音量まで、この時間かけて大きくしながら鳴らす。
  fade_in: Option[Duration],
  loudness: Loudness,
}

impl SoundPlayback {
  pub fn new(repetition: SoundRepetition, offset: Duration, fade_in: Option[Duration], loudness: Loudness) -> Self {
    Self { repetition = repetition, offset = offset, fade_in = fade_in, loudness = loudness }
  }

  // 頭から 1 回、フェードせず、正規化せずに鳴らす (SE)。
  pub fn once() -> Self {
    SoundPlayback::new(SoundRepetition::Count(1), Duration::ms(0), None, Loudness::AsIs)
  }

  // 頭から止めるまで繰り返す。フェードせず、正規化しない。
  pub fn forever() -> Self {
    SoundPlayback::new(SoundRepetition::Infinite, Duration::ms(0), None, Loudness::AsIs)
  }
}

pub(super) struct SoundObjectId {
  value: Uint,
}

impl SoundObjectId {
  pub(super) fn new(value: Uint) -> Self {
    Self { value = value }
  }

  pub(super) fn as_raw(self) -> Uint {
    self.value
  }
}

// 再生 1 回。終われば (止めれば) エンジンが解放する。終わった後の操作は黙って無視される。
//
// `volume` は最後に発火した目標の音量 (今の音量はエンジンからは取れない)。
pub struct SoundObject {
  id: SoundObjectId,
  volume: Volume,
}

impl SoundObject {
  pub fn stop(self) {
    self.stop_after(Duration::ms(0));
  }

  pub fn stop_after(self, after: Duration) {
    runtime::sound::sound_object_add_stop(self.id, after);
    runtime::timeline::timeline_fire(TimelineSync::Free);
  }

  // 無音まで `d` かけて下げてから止める。
  pub fn fade_out(self, d: Duration) {
    self.queue_fade_out(d);
    runtime::timeline::timeline_fire(TimelineSync::Free);
  }

  pub fn fade_to(self, v: Volume, d: Duration) -> Self {
    self.queue_volume(v, d);
    runtime::timeline::timeline_fire(TimelineSync::Free);
    self
  }

  pub fn move_to(self, p: SoundPosition, d: Duration) -> Self {
    runtime::sound::sound_object_add_position_transition(self.id, Transition::linear(p, d), Duration::ms(0));
    runtime::timeline::timeline_fire(TimelineSync::Free);
    self
  }

  // --- 積むだけ (発火は呼んだ側) ---

  pub(package) fn queue_volume(self, v: Volume, d: Duration) {
    self.volume = v;
    runtime::sound::sound_object_add_volume_transition(self.id, Transition::linear(v, d), Duration::ms(0));
  }

  pub(package) fn queue_fade_out(self, d: Duration) {
    runtime::sound::sound_object_add_volume_transition(self.id, Transition::linear(Volume::silent(), d), Duration::ms(0));
    runtime::sound::sound_object_add_stop(self.id, d);
  }
}

// --- Bus ----------------------------------------------------------------------

// バス。音を束ねて音量と effect を掛ける経路で、入れ子 (木) にできる。
//
// 作ったときに親・音量・effect の列が決まり、木に繋がった状態で返る。effect の列は後から変えられない。
// third party のライブラリも、std のバスの下に自由にバスを足してよい。
pub struct Bus {
  id: BusId,
  // 最後に設定した音量 (stop_all のフェードの後に戻す値)。
  volume: Volume,
}

pub(super) struct BusId {
  value: Uint,
}

impl BusId {
  pub(super) fn new(value: Uint) -> Self {
    Self { value = value }
  }

  pub(super) fn as_raw(self) -> Uint {
    self.value
  }
}

// バスの繋ぎ先。
pub enum BusParent {
  // 出力 (スピーカ)。繋げる根は 1 本だけで、std の master が使う (2 本目は警告して無視される)。
  Output,
  Bus(Bus),
}

// バスに挿す effect。列の順に掛かる。
pub enum BusEffect {
  PassFilter(PassFilter),
  Compressor(Compressor),
  Duck(Duck),
}

impl Bus {
  pub fn new(parent: BusParent, volume: Volume, effects: Vec[BusEffect]) -> Self {
    Self { id = runtime::sound::sound_bus_create(parent, volume, effects), volume = volume }
  }

  // `parent` の下に、0 dB・effect 無しのバスを作る。
  pub fn under(parent: Bus) -> Self {
    Bus::new(BusParent::Bus(parent), Volume::db(0.0), Vec::new())
  }

  pub(super) fn id(self) -> BusId {
    self.id
  }

  // このバスで鳴らす。返るときには鳴り始めている。
  pub fn play(self, sound: Sound, playback: SoundPlayback) -> SoundObject {
    let object = self.queue_play(sound, playback);
    runtime::timeline::timeline_fire(TimelineSync::Free);
    object
  }

  // 鳴らす音を作って開始を積む (発火は呼んだ側)。
  pub(package) fn queue_play(self, sound: Sound, playback: SoundPlayback) -> SoundObject {
    let initial = match playback.fade_in {
      Some(_) => Volume::silent(),
      None => sound.volume,
    };
    let id = runtime::sound::sound_object_create(
      sound.path, self.id, initial, sound.position, sound.loop_range, playback.loudness);
    runtime::sound::sound_object_add_start(id, Duration::ms(0), playback.offset, playback.repetition);
    let object = SoundObject { id = id, volume = sound.volume };
    match playback.fade_in {
      Some(d) => { object.queue_volume(sound.volume, d); }
      None => {}
    }
    object
  }

  // すぐに音量を設定する (発火を待たない)。
  pub fn set_volume(self, v: Volume) {
    self.volume = v;
    runtime::sound::sound_bus_set_volume(self.id, v);
  }

  pub fn fade_to(self, v: Volume, d: Duration) -> Self {
    self.volume = v;
    runtime::sound::sound_bus_add_volume_transition(self.id, Transition::linear(v, d), Duration::ms(0));
    runtime::timeline::timeline_fire(TimelineSync::Free);
    self
  }

  // このバス (と子孫) で鳴っている音をすべて止める。`fade` があれば、バスの音量を下げてから止め、音量を戻す。
  pub fn stop_all(self, fade: Duration) {
    self.queue_stop_all(fade);
    runtime::timeline::timeline_fire(TimelineSync::Free);
  }

  pub(package) fn queue_stop_all(self, fade: Duration) {
    if fade.as_ms() == 0 {
      runtime::sound::sound_bus_add_stop_all(self.id, Duration::ms(0));
    } else {
      runtime::sound::sound_bus_add_volume_transition(
        self.id, Transition::linear(Volume::silent(), fade), Duration::ms(0));
      runtime::sound::sound_bus_add_stop_all(self.id, fade);
      runtime::sound::sound_bus_add_volume_transition(
        self.id, Transition::linear(self.volume, Duration::ms(0)), fade);
    }
  }

  // `after` の後に、このバスとその子孫 (と中の音・effect) を消す。
  pub fn delete(self, after: Duration) {
    runtime::sound::sound_bus_delete(self.id, after);
  }
}

// --- effect -------------------------------------------------------------------
//
// effect は作った時点でエンジンに実在し、必要な値はすべて作るときに受け取る。
// 作ったものを `Bus::new` の effect の列に入れて使う。手元に残った値が、そのままパラメータを動かすハンドルになる
// (例: 水に潜る場面で bgm の high_cut を下げる)。
// 1 つの effect は 1 つのバスにしか入れられない。どのバスにも入れなかった effect は何もしない。

pub(super) struct SoundEffectId {
  value: Uint,
}

impl SoundEffectId {
  pub(super) fn new(value: Uint) -> Self {
    Self { value = value }
  }

  pub(super) fn as_raw(self) -> Uint {
    self.value
  }
}

// pass filter の傾き。
pub enum FilterSlope {
  // 12 dB/oct。
  Gentle,
  // 24 dB/oct (「切った」感じが強い)。
  Steep,
}

// 帯域制限。`low_cut` より低い音と `high_cut` より高い音を弱める。`None` はその側を削らない。
// 例: こもった音は high_cut を 500 Hz、電話の声は 300〜3400 Hz。
pub struct PassFilter {
  id: SoundEffectId,
}

impl PassFilter {
  pub fn new(slope: FilterSlope, low_cut: Option[Hz], high_cut: Option[Hz]) -> Self {
    Self { id = runtime::sound::sound_effect_create_pass_filter(slope, low_cut, high_cut) }
  }

  // 何も削らない (後で動かすために挿しておく)。
  pub fn open(slope: FilterSlope) -> Self {
    PassFilter::new(slope, None, None)
  }

  pub(super) fn id(self) -> SoundEffectId {
    self.id
  }

  // すぐに設定する (発火を待たない)。
  pub fn set_low_cut(self, cutoff: Option[Hz]) {
    runtime::sound::sound_pass_filter_set_low_cut(self.id, cutoff);
  }

  pub fn set_high_cut(self, cutoff: Option[Hz]) {
    runtime::sound::sound_pass_filter_set_high_cut(self.id, cutoff);
  }

  pub fn low_cut_to(self, cutoff: Option[Hz], d: Duration) {
    runtime::sound::sound_pass_filter_add_low_cut_transition(self.id, Transition::linear(cutoff, d), Duration::ms(0));
    runtime::timeline::timeline_fire(TimelineSync::Free);
  }

  // 例: 水に潜る場面は bgm の high_cut を `None` (削らない) → `Some(hz(500.0))` へ 1 秒で。
  pub fn high_cut_to(self, cutoff: Option[Hz], d: Duration) {
    runtime::sound::sound_pass_filter_add_high_cut_transition(self.id, Transition::linear(cutoff, d), Duration::ms(0));
    runtime::timeline::timeline_fire(TimelineSync::Free);
  }
}

// 圧縮。`threshold` を超えた分を `ratio` で縮め、`makeup` だけ持ち上げる。
// attack は縮め始める速さ、release は戻る速さ。
pub struct Compressor {
  id: SoundEffectId,
}

impl Compressor {
  pub fn new(threshold: Volume, ratio: CompressionRatio, attack: Duration, release: Duration, makeup: Volume) -> Self {
    Self { id = runtime::sound::sound_effect_create_compressor(threshold, ratio, attack, release, makeup) }
  }

  // 割れ (クリッピング) を防ぐリミッタ。master の最後に挿す。
  pub fn limiter() -> Self {
    Compressor::new(Volume::db(-1.0), CompressionRatio::new(20.0), Duration::ms(1), Duration::ms(100), Volume::db(0.0))
  }

  pub(super) fn id(self) -> SoundEffectId {
    self.id
  }
}

// ダッキングの量と速さ。`amount` だけ下げる。attack は下げに入る速さ、release は戻る速さ
// (どちらも「下げ幅の全部を動く時間」。短すぎると音量が呼吸するように上下する。目安は attack 50〜100 ms、release 300〜800 ms)。
pub struct Ducking {
  amount: Volume,
  attack: Duration,
  release: Duration,
}

impl Ducking {
  pub fn new(amount: Volume, attack: Duration, release: Duration) -> Self {
    Self { amount = amount, attack = attack, release = release }
  }

  // ボイスが鳴る間 BGM を 10 dB 下げる、ノベルゲームの既定。
  pub fn default() -> Self {
    Ducking::new(Volume::db(-10.0), Duration::ms(80), Duration::ms(500))
  }

  // 下げない。
  pub fn none() -> Self {
    Ducking::new(Volume::db(0.0), Duration::ms(80), Duration::ms(500))
  }

  pub(super) fn amount(self) -> Volume { self.amount }
  pub(super) fn attack(self) -> Duration { self.attack }
  pub(super) fn release(self) -> Duration { self.release }
}

// ダッキング。`key` のバス (とその子孫) で音が鳴っている間、このバスを下げる。
pub struct Duck {
  id: SoundEffectId,
}

impl Duck {
  pub fn new(key: Bus, ducking: Ducking) -> Self {
    Self { id = runtime::sound::sound_effect_create_duck(key.id(), ducking) }
  }

  pub(super) fn id(self) -> SoundEffectId {
    self.id
  }

  // 量と速さを変える。すぐに効く。
  pub fn set(self, ducking: Ducking) {
    runtime::sound::sound_duck_set(self.id, ducking);
  }
}

// --- 既定の木と音量の設定 -----------------------------------------------------

// プレイヤーが設定画面で変える音量 (バスごと)。
pub struct Volumes {
  master: Volume,
  bgm: Volume,
  ambient: Volume,
  se: Volume,
  voice: Volume,
  system: Volume,
}

impl Volumes {
  // master を -3 dB にして、音が重なったときの余裕を残す。他は 0 dB。
  pub fn default() -> Self {
    Volumes::new(Volume::db(-3.0), Volume::db(0.0), Volume::db(0.0), Volume::db(0.0), Volume::db(0.0), Volume::db(0.0))
  }

  pub fn new(master: Volume, bgm: Volume, ambient: Volume, se: Volume, voice: Volume, system: Volume) -> Self {
    Self { master = master, bgm = bgm, ambient = ambient, se = se, voice = voice, system = system }
  }
}

// std が作る既定のバスの木。Window の寿命のもので、`WindowHandle` が `Game` に運ぶ。
//
// ```
// master   (リミッタ。出力に繋がる)
// ├─ voice
// │   └─ voice/<キャラ> (`Character::new` が作る)
// ├─ bgm   (ボイスが鳴る間だけ下がる)
// ├─ ambient
// ├─ se
// └─ system (UI の音)
// ```
pub struct SoundBuses {
  master: Bus,
  bgm: Bus,
  ambient: Bus,
  se: Bus,
  voice: Bus,
  system: Bus,
  bgm_duck: Duck,
}

impl SoundBuses {
  // 既定の木を作って出力に繋ぐ。`fn main()` で作って `Window::sound` に渡せば、その下に自前のバスを足せる。
  // 渡さなければ `Window::show()` がこれを作る。
  //
  // 音量とダッキングは `Window::show()` が設定 (`Config`) から当てるので、ここでは 0 dB・ダッキング無しで作る。
  pub fn standard() -> Self {
    let master = Bus::new(BusParent::Output, Volume::db(0.0), Vec::of(BusEffect::Compressor(Compressor::limiter())));
    // bgm の duck が voice を key にするので、voice を先に作る。
    let voice = Bus::under(master);
    let bgm_duck = Duck::new(voice, Ducking::none());
    Self {
      master = master,
      bgm = Bus::new(BusParent::Bus(master), Volume::db(0.0), Vec::of(BusEffect::Duck(bgm_duck))),
      ambient = Bus::under(master),
      se = Bus::under(master),
      voice = voice,
      system = Bus::under(master),
      bgm_duck = bgm_duck,
    }
  }

  pub fn master(self) -> Bus { self.master }
  pub fn bgm(self) -> Bus { self.bgm }
  pub fn ambient(self) -> Bus { self.ambient }
  pub fn se(self) -> Bus { self.se }
  pub fn voice(self) -> Bus { self.voice }
  pub fn system(self) -> Bus { self.system }

  // 音量の設定を各バスに反映する。鳴っている音にも効く。
  pub(package) fn apply_volumes(self, v: Volumes) {
    self.master.set_volume(v.master);
    self.bgm.set_volume(v.bgm);
    self.ambient.set_volume(v.ambient);
    self.se.set_volume(v.se);
    self.voice.set_volume(v.voice);
    self.system.set_volume(v.system);
  }

  // `None` ならダッキングしない。
  pub(package) fn apply_ducking(self, ducking: Option[Ducking]) {
    match ducking {
      Some(d) => { self.bgm_duck.set(d); }
      None => { self.bgm_duck.set(Ducking::none()); }
    }
  }
}

// --- Game から見た音 ----------------------------------------------------------

// 今鳴っている BGM。`change_bgm` が同じ曲なら何もしないために、パスも覚える。
pub(package) struct BgmState {
  current: Option[CurrentBgm],
}

pub(package) struct CurrentBgm {
  path: String,
  object: SoundObject,
}

impl BgmState {
  pub(package) fn new() -> Self {
    Self { current = None }
  }

  // 今の BGM を `fade` かけて下げてから止めるよう積む (発火は呼んだ側)。
  fn queue_fade_out(self, fade: Duration) {
    match self.current {
      Some(cur) => { cur.object.queue_fade_out(fade); }
      None => {}
    }
  }
}

// `g.sound()` が返すもの。既定のバスと音量の設定に触れる。
pub struct GameSound {
  buses: SoundBuses,
  config: Config,
}

impl GameSound {
  pub(package) fn new(buses: SoundBuses, config: Config) -> Self {
    Self { buses = buses, config = config }
  }

  pub fn buses(self) -> SoundBuses {
    self.buses
  }

  pub fn volumes(self) -> Volumes {
    self.config.user().volumes()
  }

  // プレイヤーの音量の設定を変える。Window の設定を書き換えるので、プレイをまたいで残る。
  pub fn set_volumes(self, v: Volumes) {
    self.config.user().set_volumes(v);
    self.buses.apply_volumes(v);
  }
}

impl[S] Game[S] {
  pub fn sound(self) -> GameSound {
    GameSound::new(self.window.sound(), self.window.config())
  }

  // SE を 1 回鳴らす。SE はラウドネス正規化をしない (大小を意図して付けていることが多いため)。
  pub fn play_se(self, s: Sound) -> SoundObject {
    self.window.sound().se().play(s, SoundPlayback::once())
  }

  // SE を鳴らして終わるまで待つ。クリックで飛ばせる (飛ばすと止まる)。
  pub fn play_se_and_wait(self, s: Sound) -> SoundObject {
    let object = self.window.sound().se().queue_play(s, SoundPlayback::once());
    runtime::timeline::timeline_fire(TimelineSync::Sync);
    runtime::timeline::timeline_await_synced();
    object
  }

  // 環境音を止めるまで鳴らす。`fade` かけて大きくする。
  pub fn play_ambient(self, s: Sound, fade: Duration) -> SoundObject {
    let playback = SoundPlayback::new(SoundRepetition::Infinite, Duration::ms(0), fade_in(fade), Loudness::AsIs);
    self.window.sound().ambient().play(s, playback)
  }

  // BGM を替える。今の BGM を `fade` かけて下げながら、新しい BGM を `fade` かけて上げる (クロスフェード)。
  // 同じファイルが鳴っていれば何もしない。
  pub fn change_bgm(self, s: Sound, fade: Duration) -> Self {
    let same = match self.bgm.current {
      Some(cur) => runtime::string_eq(cur.path, s.path),
      None => FALSE,
    };
    if same {
    } else {
      self.bgm.queue_fade_out(fade);
      let playback = SoundPlayback::new(SoundRepetition::Infinite, Duration::ms(0), fade_in(fade), Loudness::Normalize);
      let object = self.window.sound().bgm().queue_play(s, playback);
      runtime::timeline::timeline_fire(TimelineSync::Free);
      self.bgm.current = Some(CurrentBgm { path = s.path, object = object });
    }
    self
  }

  // BGM を `fade` かけて止める。
  pub fn stop_bgm(self, fade: Duration) -> Self {
    match self.bgm.current {
      Some(cur) => {
        cur.object.fade_out(fade);
        self.bgm.current = None;
      }
      None => {}
    }
    self
  }
}

// --- 数 -----------------------------------------------------------------------

// フェードの時間が 0 なら、フェードせずに目標の音量から鳴らす。
fn fade_in(fade: Duration) -> Option[Duration] {
  if fade.as_ms() == 0 { None } else { Some(fade) }
}

// 常用対数。`x` は正であること。
fn log10(x: Float) -> Float {
  log2(x) * 0.30103
}

// 2 を底とする対数。x = m * 2^e (1 <= m < 2) に分け、ln(m) は atanh の級数で求める。
fn log2(x: Float) -> Float {
  let e = 0.0;
  let m = x;
  while m >= 2.0 {
    m = m / 2.0;
    e = e + 1.0;
  }
  while m < 1.0 {
    m = m * 2.0;
    e = e - 1.0;
  }
  // ln(m) = 2 * atanh(z)、z = (m - 1) / (m + 1)。m < 2 なので z < 1/3 で、すぐに収まる。
  let z = (m - 1.0) / (m + 1.0);
  let z2 = z * z;
  let term = z;
  let sum = 0.0;
  let k = 1.0;
  while k < 20.0 {
    sum = sum + term / k;
    term = term * z2;
    k = k + 2.0;
  }
  e + 2.0 * sum / 0.6931472
}
