import package::string::String;
import package::option::Option;
import package::option::Option::Some;
import package::option::Option::None;
import package::time::Duration;
import package::game::Character;
import package::game::Game;
import package::game::ui::GameCanvas;
import package::game::image::Image;
import package::game::canvas::CanvasObject;
import package::game::canvas::ObjectBatchChain;
import package::game::canvas::ObjectParamChain;
import package::game::canvas::Cx;
import package::game::canvas::Cy;
import package::game::canvas::Cw;
import package::game::canvas::Ch;
import package::game::canvas::Theta;
import package::game::canvas::Position;
import package::game::color::Alpha;

impl[P] Character[P] {
  // **暫定**: `Game` を受け取るが、保持するのは出力先の束 (`GameWindow`) だけである
  // (`Character.window` のコメント参照)。
  fn new[S](
    game: Game[S],
    name: String,
    display_name: String,
    props: P,
    default_visual: Image,
    default_face: Image,
  ) -> Self {
    Self {
      name = name,
      display_name = display_name,
      props = props,
      default_visual = default_visual,
      default_face = default_face,
      current_visual = None,
      current_face = None,
      current_position = None,
      window = game.window,
    }
  }

  // 描画の出力先。無ければ止める (`Game::canvas` と同じ扱い)。
  fn canvas(self) -> GameCanvas {
    self.window.canvas.unwrap()
  }

  fn is_on_screen(self) -> Bool {
    self.current_visual.is_some()
  }

  // 画面上に登場する。
  //
  // 座標・大きさは canvas の範囲が -50.0 から 50.0 になる単位 (`std::game::canvas`)。
  // `w` / `h` の片方だけ Auto なら画像の縦横比を保つように、両方 Auto なら画像の元の大きさ (px)。
  // 透明 (alpha = 0) で出しておいて遷移で現す、という使い方をする。
  fn appear(self, layer: Uint, x: Cx, y: Cy, w: Cw, h: Ch, alpha: Alpha) -> Self {
    self.current_visual =
      Some(self.default_visual.show_in_canvas(self.canvas(), layer, x, y, w, h, alpha));
    self.current_position = Some(Position { x = x, y = y });

    self
  }

  // 画面上から消える。
  fn disappear(self, after: Duration) -> Self {
    match self.current_visual {
      Some(visual) => {
        visual.delete(after);
        self.current_visual = None;
        self.current_position = None;

        self
      },
      None => self,
    }
  }

  // 立ち絵を差し替える。
  //
  // 動いている画像の「今の位置」はエンジンからは取れない。
  // 代わりに std が積んだ遷移の目標値 (= アニメーション後の値) を覚えているので、
  // そこへ新しい画像を出してから古いものを消す。
  // 走っている遷移の途中で呼ぶと、その遷移の行き先に飛ぶことになる。
  // pub
  fn change_visual(self, visual: Image) -> Self {
    match self.current_visual {
      Some(old) => {
        let fresh = CanvasObject::create(
          visual, old.canvas, old.layer, old.x, old.y, old.w, old.h, old.alpha);
        old.delete(Duration::ms(0));
        self.current_visual = Some(fresh);
        self.default_visual = visual;

        self
      },
      None => self,
    }
  }

  // --- チェーンの入口 ---
  //
  // まだ画面に出ていなければ、チェーンは何もしない (登場前に遷移を書いても落ちずに無視される)。

  fn and(self) -> CharacterBatchChain[P] {
    CharacterBatchChain {
      chara = self,
      inner = match self.current_visual {
        Some(visual) => Some(visual.and()),
        None => None,
      },
    }
  }

  fn x_then(self) -> CharacterParamXChain[P] {
    CharacterParamXChain::new(self, match self.current_visual {
      Some(visual) => Some(visual.x_then()),
      None => None,
    })
  }

  fn y_then(self) -> CharacterParamYChain[P] {
    CharacterParamYChain::new(self, match self.current_visual {
      Some(visual) => Some(visual.y_then()),
      None => None,
    })
  }

  fn w_then(self) -> CharacterParamWChain[P] {
    CharacterParamWChain::new(self, match self.current_visual {
      Some(visual) => Some(visual.w_then()),
      None => None,
    })
  }

  fn h_then(self) -> CharacterParamHChain[P] {
    CharacterParamHChain::new(self, match self.current_visual {
      Some(visual) => Some(visual.h_then()),
      None => None,
    })
  }

  fn alpha_then(self) -> CharacterParamAlphaChain[P] {
    CharacterParamAlphaChain::new(self, match self.current_visual {
      Some(visual) => Some(visual.alpha_then()),
      None => None,
    })
  }

  fn theta_then(self) -> CharacterParamThetaChain[P] {
    CharacterParamThetaChain::new(self, match self.current_visual {
      Some(visual) => Some(visual.theta_then()),
      None => None,
    })
  }

  // --- 1 つだけ動かす近道 ---

  fn x_move(self, x: Cx, duration: Duration) -> Self {
    self.x_then().linear_then(x, duration).animate()
  }

  fn x_easeout(self, x: Cx, duration: Duration) -> Self {
    self.x_then().easeout_then(x, duration).animate()
  }

  fn fade_in(self, duration: Duration) -> Self {
    self.alpha_then().linear_then(Alpha::opaque(), duration).animate()
  }

  fn fade_out(self, duration: Duration) -> Self {
    self.alpha_then().linear_then(Alpha::transparent(), duration).animate()
  }
}

// --- Character 用のチェーン -------------------------------------------------
//
// 中身は CanvasObject のチェーンそのままで、最後に Character を返すためだけに包んでいる。
// これで `chara.and()....animate_for(d).and()...` と続けて書ける。
// 画面に出ていない Character のチェーンは中身が無く (`None`)、何もしない。

struct CharacterBatchChain[P] {
  chara: Character[P],
  inner: Option[ObjectBatchChain],
}

impl[P] CharacterBatchChain[P] {
  fn x_move_and(self, x: Cx) -> Self {
    match self.inner {
      Some(inner) => { inner.x_move_and(x); },
      None => {},
    }
    self
  }

  fn y_move_and(self, y: Cy) -> Self {
    match self.inner {
      Some(inner) => { inner.y_move_and(y); },
      None => {},
    }
    self
  }

  fn x_easein_and(self, x: Cx) -> Self {
    match self.inner {
      Some(inner) => { inner.x_easein_and(x); },
      None => {},
    }
    self
  }

  fn x_easeout_and(self, x: Cx) -> Self {
    match self.inner {
      Some(inner) => { inner.x_easeout_and(x); },
      None => {},
    }
    self
  }

  fn y_easein_and(self, y: Cy) -> Self {
    match self.inner {
      Some(inner) => { inner.y_easein_and(y); },
      None => {},
    }
    self
  }

  fn y_easeout_and(self, y: Cy) -> Self {
    match self.inner {
      Some(inner) => { inner.y_easeout_and(y); },
      None => {},
    }
    self
  }

  fn w_resize_and(self, w: Cw) -> Self {
    match self.inner {
      Some(inner) => { inner.w_resize_and(w); },
      None => {},
    }
    self
  }

  fn h_resize_and(self, h: Ch) -> Self {
    match self.inner {
      Some(inner) => { inner.h_resize_and(h); },
      None => {},
    }
    self
  }

  fn fade_to_and(self, alpha: Alpha) -> Self {
    match self.inner {
      Some(inner) => { inner.fade_to_and(alpha); },
      None => {},
    }
    self
  }

  fn be_visible_and(self) -> Self {
    match self.inner {
      Some(inner) => { inner.be_visible_and(); },
      None => {},
    }
    self
  }

  fn be_invisible_and(self) -> Self {
    match self.inner {
      Some(inner) => { inner.be_invisible_and(); },
      None => {},
    }
    self
  }

  fn rotate_and(self, theta: Theta) -> Self {
    match self.inner {
      Some(inner) => { inner.rotate_and(theta); },
      None => {},
    }
    self
  }

  fn x_sin_and(self, amplitude: Cw, period: Duration) -> Self {
    match self.inner {
      Some(inner) => { inner.x_sin_and(amplitude, period); },
      None => {},
    }
    self
  }

  fn y_sin_and(self, amplitude: Ch, period: Duration) -> Self {
    match self.inner {
      Some(inner) => { inner.y_sin_and(amplitude, period); },
      None => {},
    }
    self
  }

  fn theta_sin_and(self, amplitude: Theta, period: Duration) -> Self {
    match self.inner {
      Some(inner) => { inner.theta_sin_and(amplitude, period); },
      None => {},
    }
    self
  }

  fn animate_for(self, duration: Duration) -> Character[P] {
    match self.inner {
      Some(inner) => { inner.animate_for(duration); },
      None => {},
    }
    self.chara
  }

  fn animate_free_for(self, duration: Duration) -> Character[P] {
    match self.inner {
      Some(inner) => { inner.animate_free_for(duration); },
      None => {},
    }
    self.chara
  }
}

struct CharacterParamChain[P, V, D] {
  chara: Character[P],
  inner: Option[ObjectParamChain[V, D]],
}

type CharacterParamXChain[P] = CharacterParamChain[P, Cx, Cw];
type CharacterParamYChain[P] = CharacterParamChain[P, Cy, Ch];
type CharacterParamWChain[P] = CharacterParamChain[P, Cw, Cw];
type CharacterParamHChain[P] = CharacterParamChain[P, Ch, Ch];
type CharacterParamAlphaChain[P] = CharacterParamChain[P, Alpha, Alpha];
type CharacterParamThetaChain[P] = CharacterParamChain[P, Theta, Theta];

impl[P, V, D] CharacterParamChain[P, V, D] {
  fn new(chara: Character[P], inner: Option[ObjectParamChain[V, D]]) -> Self {
    Self { chara = chara, inner = inner }
  }

  fn linear_then(self, value: V, duration: Duration) -> Self {
    match self.inner {
      Some(inner) => { inner.linear_then(value, duration); },
      None => {},
    }
    self
  }

  fn easein_then(self, value: V, duration: Duration) -> Self {
    match self.inner {
      Some(inner) => { inner.easein_then(value, duration); },
      None => {},
    }
    self
  }

  fn easeout_then(self, value: V, duration: Duration) -> Self {
    match self.inner {
      Some(inner) => { inner.easeout_then(value, duration); },
      None => {},
    }
    self
  }

  fn easeinout_then(self, value: V, duration: Duration) -> Self {
    match self.inner {
      Some(inner) => { inner.easeinout_then(value, duration); },
      None => {},
    }
    self
  }

  fn easeoutin_then(self, value: V, duration: Duration) -> Self {
    match self.inner {
      Some(inner) => { inner.easeoutin_then(value, duration); },
      None => {},
    }
    self
  }

  fn sin_then(self, amplitude: D, period: Duration, until: Duration) -> Self {
    match self.inner {
      Some(inner) => { inner.sin_then(amplitude, period, until); },
      None => {},
    }
    self
  }

  fn sin_forever(self, amplitude: D, period: Duration) -> Self {
    match self.inner {
      Some(inner) => { inner.sin_forever(amplitude, period); },
      None => {},
    }
    self
  }

  fn stop_then(self) -> Self {
    match self.inner {
      Some(inner) => { inner.stop_then(); },
      None => {},
    }
    self
  }

  fn sleep_then(self, duration: Duration) -> Self {
    match self.inner {
      Some(inner) => { inner.sleep_then(duration); },
      None => {},
    }
    self
  }
}

// 発火はパラメータごとに書く (中身の `animate()` がパラメータごとに別の実装であるため)。

impl[P] CharacterParamXChain[P] {
  fn animate(self) -> Character[P] {
    match self.inner {
      Some(inner) => { inner.animate(); },
      None => {},
    }
    self.chara
  }

  fn animate_free(self) -> Character[P] {
    match self.inner {
      Some(inner) => { inner.animate_free(); },
      None => {},
    }
    self.chara
  }
}

