import package::string::String;
import package::time::Duration;
import package::game::base_engine::int_to_float;
import package::game::ui::GameCanvas;
import package::game::canvas::Cx;
import package::game::canvas::Cy;
import package::game::canvas::Cw;
import package::game::canvas::Ch;
import package::game::canvas::CanvasObject;

// --- 画像 ------------------------------------------------------------------

// まだエンジン上ではロード/描画されていない画像を表す構造体。
// 描画したキャンバス上のオブジェクトとしては CanvasObject 構造体で表す。
struct Image {
  path: String,
}

impl Image {
  fn new(path: String) -> Self {
    Self { path = path }
  }

  // キャンバス上に描画する。
  // CanvasObject を返すので、以降はそれを使ってアニメーションなどを操作する。
  //
  // `canvas` は出力先 (UI Element `Canvas`)。座標の原点はその中央で、
  // 座標・大きさは canvas の範囲が -50.0 から 50.0 になる単位 (`std::game::canvas`)。
  // **暫定の形**: 画像を直接描く API はいずれ std の抽象 (Character など) の
  // 内側に隠れる想定なので、出力先はひとまず第一引数で受け取る。
  //
  // `w` / `h` の片方だけ Auto なら画像の縦横比を保つように、
  // 両方 Auto なら画像の元の大きさ (px) で、エンジンが決める。
  fn show_in_canvas(
    self, canvas: GameCanvas, layer: Uint, x: Cx, y: Cy, w: Cw, h: Ch, alpha: Int,
  ) -> CanvasObject {
    CanvasObject::create(self, canvas, layer, x, y, w, h, alpha)
  }
}
