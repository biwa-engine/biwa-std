import package::string::String;
import package::option::Option;
import package::option::Option::Some;
import package::option::Option::None;
import package::convert::Into;
import package::collections::Vec;
import package::game::ui::UiElement;
import package::game::ui::apply_id;
import package::game::ui::push_children;
import package::game::ui::UiId;
import package::game::base_engine::ui_create;

// 子を重ねる Element (`docs/ui-api.md` の `Layers`)。
//
// 子はそれぞれ Layers の親の中にいるのと同じように配置され、x / y 方向には
// 互いに干渉しない。前後は push された順で決まり、**後から push したものほど上**になる
// (`Layers::new(Vec::of(下)).push(上)`)。背景の Canvas の上にメッセージ枠を重ねる、
// といった用途に使う。
pub struct Layers[S] {
  children: Vec[UiElement[S]],
  id: Option[String],
}

impl[S] Layers[S] {
  // 先頭が一番下のレイヤーになる。
  pub fn new(children: Vec[UiElement[S]]) -> Self {
    Self { children = children, id = None }
  }

  // 一番上にレイヤーを 1 枚足す。
  pub fn push(self, child: UiElement[S]) -> Self {
    self.children.push(child);
    self
  }

  // すべての Element が持てる任意の識別子。
  pub fn id(self, value: String) -> Self {
    self.id = Some(value);
    self
  }

  // 木を辿って syscall を発行する。子は下のレイヤーから順に積む。
  pub(super) fn materialize(self) -> UiId {
    let id = ui_create(self.into());
    apply_id(id, self.id);
    push_children(id, self.children);
    id
  }
}

impl[S] Layers[S]: Into[UiElement[S]] {
  fn into(self) -> UiElement[S] {
    UiElement::Layers(self)
  }
}
