import package::string::String;
import package::option::Option;
import package::option::Option::Some;
import package::option::Option::None;
import package::collections::Vec;
import package::game::color::Color;
import package::game::ui::Background;
import package::game::ui::CanvasId;
import package::game::ui::MessageAreaId;
import package::game::ui::UiElement;
import package::game::ui::apply_background;
import package::game::ui::apply_id;
import package::game::ui::push_children;
import package::game::ui::UiProperty;
import package::game::ui::ScenePageId;
import package::game::base_engine::ui_create_scene_page;
import package::game::base_engine::ui_set_property;

// scene を映すページ (`docs/ui-api.md` の改訂版)。Window が 1 つだけ持つ。
//
// Link では遷移できず、`SceneStartButton` が押されて scene が始まるときに表示される。
// レイアウトは Page と同じく子 Element で自由に決める。
//
// scene の出力先 (`canvas` の Canvas API と `message_area` の Content API) は必ず受け取る。
// 受け取るのは配置ではなく ID で、実体 (`Canvas` / `MessageArea`) は子孫として自分で配置する。
// 配置し忘れ・ScenePage の外への配置はエンジンが止める (型では担保できないため)。

pub struct ScenePage[S] {
  canvas: CanvasId,
  message_area: MessageAreaId,
  children: Vec[UiElement[S]],
  background: Option[Background],
  id: Option[String],
}

impl[S] ScenePage[S] {
  // - `canvas` / `message_area`: scene の出力先 (`Canvas::canvas_id()` / `MessageArea::message_area_id()`)。
  //   実体はこの ScenePage の子孫として `children` (か `push`) で配置すること。
  // - `children`: Page と同じく、このページに置く Element の列。
  pub fn new(canvas: CanvasId, message_area: MessageAreaId, children: Vec[UiElement[S]]) -> Self {
    Self {
      canvas = canvas,
      message_area = message_area,
      children = children,
      background = None,
      id = None,
    }
  }

  pub fn push(self, child: UiElement[S]) -> Self {
    self.children.push(child);
    self
  }

  // すべての Element が持てる任意の識別子。
  pub fn id(self, value: String) -> Self {
    self.id = Some(value);
    self
  }

  pub fn background_color(self, value: Color) -> Self {
    self.background = Some(Background::Color(value));
    self
  }

  // `background_color` とは排他 (どちらか後に呼んだ方が勝つ)。
  pub fn background_image(self, value: String) -> Self {
    self.background = Some(Background::Image(value));
    self
  }

  // 木を辿って syscall を発行し、その ID を返す。Window に結びつけるのは `Window::show`。
  // 出力先が子孫に置かれているかは、Window に結びつけた時点でエンジンが確かめる。
  pub(super) fn materialize(self) -> ScenePageId {
    let id = ui_create_scene_page();
    apply_id(id, self.id);
    apply_background(id, self.background);
    ui_set_property(id, UiProperty::ScenePageCanvas(self.canvas));
    ui_set_property(id, UiProperty::ScenePageMessageArea(self.message_area));
    push_children(id, self.children);
    ScenePageId::new(id)
  }
}
