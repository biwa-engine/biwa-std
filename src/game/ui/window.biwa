import package::string::String;
import package::option::Option;
import package::option::Option::Some;
import package::option::Option::None;
import package::collections::Vec;
import package::game::Scene;
import package::game::ui::Page;
import package::game::ui::ScenePage;
import package::game::ui::apply_id;
import package::game::ui::UiProperty;
import package::game::ui::UiEventHandler;
import package::game::base_engine::ui_create_window;
import package::game::base_engine::ui_set_property;
import package::game::base_engine::ui_set_handler;

// ウィンドウ。UI の root となる Element。子は Page のみ持てる。
//
// 型引数 `S` はゲームの状態の型 (`Game[S]` の `S`)。UI の木全体で共有し、
// `main_scene` と `SceneStartButton` の `on_click` の `Game[S]` を揃える。
//
// ノベルゲームとして scene を始められることを保証するもの (`main_scene` / `scene_page`) は
// `Option` にせず、`Window::new` の引数で必ず受け取る。エンジンも、これらが設定されないまま
// Page を積まれたら止める。
//
// ゲーム側の `fn main()` (エントリポイント) がこれを組み立てて `show()` する。
[[lang="ui_window"]]
pub struct Window[S] {
  pages: Vec[Page[S]],
  id: Option[String],
  // scene 本体。`SceneStartButton` が押されると、その `on_click` が作った `Game[S]` でこれが始まる。
  main_scene: Scene[S],
  // scene を映すページ。scene が始まるときに表示され、その Canvas / MessageArea が scene の出力先になる。
  scene_page: ScenePage[S],
}

impl[S] Window[S] {
  // Window を組み立てる。まだ syscall は発行しない。
  //
  // - `main_scene`: scene 本体。`SceneStartButton` が押されると始まる。
  // - `scene_page`: scene を映すページ。その Canvas / MessageArea が scene の出力先になる。
  // - `pages`: 子となる Page の列。
  //
  // `main_scene` と `scene_page` はノベルゲームとして scene を始めるのに欠かせないので、
  // ビルダーではなくここで必ず受け取る。
  pub fn new(main_scene: Scene[S], scene_page: ScenePage[S], pages: Vec[Page[S]]) -> Self {
    Self { pages = pages, id = None, main_scene = main_scene, scene_page = scene_page }
  }

  // Page を追加する。
  pub fn push(self, page: Page[S]) -> Self {
    self.pages.push(page);
    self
  }

  // すべての Element が持てる任意の識別子。
  pub fn id(self, value: String) -> Self {
    self.id = Some(value);
    self
  }

  // 木を辿って syscall を発行し、実際に画面へ出現させる。ゲーム側の `fn main()` から呼ぶ。
  // 最初に積まれた Page が既定で表示される (エンジン側の規則)。
  // Window は UiElement ではないため、この関数が Page 側の消費点でもある。
  pub fn show(self) {
    let id = ui_create_window();
    apply_id(id, self.id);
    // Page を積む前に設定する。エンジンは、これらが無いまま Page を積まれたら止める。
    // ScenePage は ID を Window に設定すると Window に結びつく (push_child はしない。Link では遷移できない)。
    ui_set_property(id, UiProperty::WindowScenePage(self.scene_page.materialize()));
    // scene 本体はホストに預ける (`docs/host-function-values.md`)。
    ui_set_handler(id, UiEventHandler::WindowMainScene(self.main_scene));
    let i = 0;
    while i < self.pages.len() {
      self.pages.get(i).unwrap().materialize_into(id);
      i = i + 1;
    }
  }
}
