import package::string::String;
import package::option::Option;
import package::option::Option::Some;
import package::option::Option::None;
import package::collections::Vec;
import package::game::Scene;
import package::game::ui::Page;
import package::game::ui::ScenePage;
import package::game::ui::apply_id;
import package::game::ui::UiProperty;
import package::game::ui::UiEventHandler;
import package::game::ui::WindowHandle;
import package::game::config::Config;
import package::game::sound::SoundBuses;
import package::game::runtime;

// ウィンドウ。UI の root となる Element。子は Page のみ持てる。
//
// 型引数 `S` はゲームの状態の型 (`Game[S]` の `S`)。UI の木全体で共有し、
// `main_scene` と `SceneStartButton` の `on_click` の `Game[S]` を揃える。
//
// ノベルゲームとして scene を始められることを保証するもの (`main_scene` / `scene_page`) は
// `Option` にせず、`Window::new` の引数で必ず受け取る。エンジンも、これらが設定されないまま
// Page を積まれたら止める。
//
// ゲーム側の `fn main()` (エントリポイント) がこれを組み立てて `show()` する。
[[lang="ui_window"]]
pub struct Window[S] {
  pages: Vec[Page[S]],
  id: Option[String],
  // scene 本体。`SceneStartButton` が押されると、その `on_click` が作った `Game[S]` でこれが始まる。
  main_scene: Scene[S],
  // scene を映すページ。scene が始まるときに表示され、その Canvas / MessageArea が scene の出力先になる。
  scene_page: ScenePage[S],
  // ゲームの設定。`WindowHandle` に入れて `Game` と共有する。既定は `Config::default()`。
  config: Config,
  // 音のバスの木。None なら `show()` が `SoundBuses::standard()` を作る。
  sound: Option[SoundBuses],
}

impl[S] Window[S] {
  // Window を組み立てる。まだ syscall は発行しない。
  //
  // - `main_scene`: scene 本体。`SceneStartButton` が押されると始まる。
  // - `scene_page`: scene を映すページ。その Canvas / MessageArea が scene の出力先になる。
  // - `pages`: 子となる Page の列。
  //
  // `main_scene` と `scene_page` はノベルゲームとして scene を始めるのに欠かせないので、
  // ビルダーではなくここで必ず受け取る。
  pub fn new(main_scene: Scene[S], scene_page: ScenePage[S], pages: Vec[Page[S]]) -> Self {
    Self { pages = pages, id = None, main_scene = main_scene, scene_page = scene_page, config = Config::default(), sound = None }
  }

  // Page を追加する。
  pub fn push(self, page: Page[S]) -> Self {
    self.pages.push(page);
    self
  }

  // ゲームの設定 (文字の速さ・大きさ・色など)。省くと `Config::default()`。
  pub fn config(self, value: Config) -> Self {
    self.config = value;
    self
  }

  // 音のバスの木。`fn main()` で `SoundBuses::standard()` を作り、その下に自前のバスを足してから渡す。
  // 省くと `show()` が `SoundBuses::standard()` を作る (多くのゲームは書かなくてよい)。
  pub fn sound(self, value: SoundBuses) -> Self {
    self.sound = Some(value);
    self
  }

  // すべての Element が持てる任意の識別子。
  pub fn id(self, value: String) -> Self {
    self.id = Some(value);
    self
  }

  // 木を辿って syscall を発行し、実際に画面へ出現させる。ゲーム側の `fn main()` から呼ぶ。
  // 最初に積まれた Page が既定で表示される (エンジン側の規則)。
  // Window は UiElement ではないため、この関数が Page 側の消費点でもある。
  pub fn show(self) {
    // Window の寿命のものの束。出力先は ScenePage を materialize する前に取り出しておく。
    // 音の木は Window の寿命のもので、出力にはここで (省かれていれば作って) 繋がっている。
    // プレイヤーの音量の設定とダッキングの設定を反映する。
    let sound = match self.sound {
      Some(sound) => sound,
      None => SoundBuses::standard(),
    };
    sound.apply_volumes(self.config.user().volumes());
    sound.apply_ducking(self.config.dev().bgm_ducking());
    let handle = WindowHandle::new(
      self.scene_page.canvas_id(), self.scene_page.message_area_id(), self.config, sound);
    let id = runtime::ui::ui_create_window();
    apply_id(id, self.id);
    // Page を積む前に設定する。エンジンは、これらが無いまま Page を積まれたら止める。
    // ScenePage は ID を Window に設定すると Window に結びつく (push_child はしない。Link では遷移できない)。
    runtime::ui::ui_set_property(id, UiProperty::WindowScenePage(self.scene_page.materialize()));
    // scene 本体はホストに預ける (`docs/host-function-values.md`)。
    runtime::ui::ui_set_handler(id, UiEventHandler::WindowMainScene(self.main_scene));
    // `WindowHandle` も預ける。scene を始めるときに、ホストがそのまま `SceneStartButton` の `on_click` に渡す。
    runtime::ui::ui_set_window_handle(id, handle);
    let i = 0;
    while i < self.pages.len() {
      self.pages.get(i).unwrap().materialize_into(id);
      i = i + 1;
    }
  }
}
