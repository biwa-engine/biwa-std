// `Window[S]` (UI の root Element) の impl。
//
// struct 定義は `game/ui.biwa` にある。ここにはコンストラクタと、
// 木を辿って syscall を発行する `materialize` 相当の `show` を置く。

import package::string::String;
import package::option::Option;
import package::option::Option::Some;
import package::option::Option::None;
import package::collections::Vec;
import package::game::Scene;
import package::game::base_engine::sys_ui_create;
import package::game::base_engine::sys_ui_set_handler;
import package::game::base_engine::sys_ui_set_property_with_string;
import package::game::ui::Window;
import package::game::ui::Page;
import package::game::ui::element_kind_window;
import package::game::ui::apply_id;
import package::game::ui::property_kind_window_scene_page_id;
import package::game::ui::handler_kind_window_main_scene;

impl[S] Window[S] {
  // Window を組み立てる。まだ syscall は発行しない。
  //
  // - `main_scene`: scene 本体。scene を映す Page に遷移すると始まる。
  // - `scene_page_id`: scene を映す Page の page_id。その Page の `canvas` / `message_area` が
  //   scene の出力先になる。
  // - `pages`: 子となる Page の列。
  //
  // `main_scene` と `scene_page_id` はノベルゲームとして scene を始めるのに欠かせないので、
  // ビルダーではなくここで必ず受け取る。
  fn new(main_scene: Scene[S], scene_page_id: String, pages: Vec[Page[S]]) -> Self {
    Self { pages = pages, id = None, main_scene = main_scene, scene_page_id = scene_page_id }
  }

  // Page を追加する。
  fn push(self, page: Page[S]) -> Self {
    self.pages.push(page);
    self
  }

  // すべての Element が持てる任意の識別子。
  fn id(self, value: String) -> Self {
    self.id = Some(value);
    self
  }

  // 木を辿って syscall を発行し、実際に画面へ出現させる。ゲーム側の `fn app()` から呼ぶ。
  // 最初に積まれた Page が既定で表示される (エンジン側の規則)。
  // Window は UiElement ではないため、この関数が Page 側の消費点でもある。
  fn show(self) {
    let id = sys_ui_create(element_kind_window());
    apply_id(id, self.id);
    // Page を積む前に設定する。最初の Page が積まれた時点で表示されるので、
    // それが scene の Page なら、その時点で分かっている必要がある。
    // エンジンも、これらが無いまま Page を積まれたら止める。
    sys_ui_set_property_with_string(id, property_kind_window_scene_page_id(), 0, 0, 0.0, self.scene_page_id);
    // scene 本体はホストに預ける (`docs/host-function-values.md`)。
    sys_ui_set_handler(id, handler_kind_window_main_scene(), self.main_scene);
    let i = 0;
    while i < self.pages.len() {
      self.pages.get(i).unwrap().materialize_into(id);
      i = i + 1;
    }
  }
}
