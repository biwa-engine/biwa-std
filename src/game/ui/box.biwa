// `Box` (子を 1 つまで持てる最も基本的な Element) の impl。
//
// struct 定義は `game/ui.biwa` にある。ビルダーメソッドは生成中・保持中の
// 型安全性のために `Box` という具体型に直接生やす。`UiElement` へは
// `Into[UiElement]` で、子として親に渡す最後の瞬間にだけ変換する。

import package::string::String;
import package::option::Option;
import package::option::Option::Some;
import package::option::Option::None;
import package::convert::Into;
import package::game::color::Color;
import package::game::base_engine::ui_create;
import package::game::base_engine::ui_push_child;
import package::game::ui::UiElement;
import package::game::ui::UiSize;
import package::game::ui::Background;
import package::game::ui::Box;
import package::game::ui::apply_layout_properties;
import package::game::ui::apply_text_properties;
import package::game::ui::apply_id;
import package::game::ui::UiId;

impl[S] Box[S] {
  // 子もテキストも持たない Box。`child` / `text` で後から足す。
  pub fn new() -> Self {
    Self {
      child = None,
      id = None,
      width = None,
      height = None,
      margin_left = None,
      margin_right = None,
      margin_top = None,
      margin_bottom = None,
      padding_left = None,
      padding_right = None,
      padding_top = None,
      padding_bottom = None,
      background = None,
      text = None,
      text_font = None,
      text_size = None,
      text_weight = None,
      text_color = None,
    }
  }

  // 子を設定する。Box が持てる子は 1 つまでなので、呼び直すと置き換わる。
  pub fn child(self, value: UiElement[S]) -> Self {
    self.child = Some(value);
    self
  }

  // すべての Element が持てる任意の識別子。
  pub fn id(self, value: String) -> Self {
    self.id = Some(value);
    self
  }

  pub fn width(self, value: UiSize) -> Self {
    self.width = Some(value);
    self
  }

  pub fn height(self, value: UiSize) -> Self {
    self.height = Some(value);
    self
  }

  pub fn margin_left(self, value: UiSize) -> Self {
    self.margin_left = Some(value);
    self
  }

  pub fn margin_right(self, value: UiSize) -> Self {
    self.margin_right = Some(value);
    self
  }

  pub fn margin_top(self, value: UiSize) -> Self {
    self.margin_top = Some(value);
    self
  }

  pub fn margin_bottom(self, value: UiSize) -> Self {
    self.margin_bottom = Some(value);
    self
  }

  pub fn padding_left(self, value: UiSize) -> Self {
    self.padding_left = Some(value);
    self
  }

  pub fn padding_right(self, value: UiSize) -> Self {
    self.padding_right = Some(value);
    self
  }

  pub fn padding_top(self, value: UiSize) -> Self {
    self.padding_top = Some(value);
    self
  }

  pub fn padding_bottom(self, value: UiSize) -> Self {
    self.padding_bottom = Some(value);
    self
  }

  pub fn background_color(self, value: Color) -> Self {
    self.background = Some(Background::Color(value));
    self
  }

  // `background_color` とは排他 (どちらか後に呼んだ方が勝つ)。
  pub fn background_image(self, value: String) -> Self {
    self.background = Some(Background::Image(value));
    self
  }

  // 表示する文字列。子と両方持つときは子より前に並ぶ。
  pub fn text(self, value: String) -> Self {
    self.text = Some(value);
    self
  }

  // CSS の font-family としてそのまま使うフォント名。
  pub fn text_font(self, value: String) -> Self {
    self.text_font = Some(value);
    self
  }

  pub fn text_size(self, value: UiSize) -> Self {
    self.text_size = Some(value);
    self
  }

  // 100〜900。
  pub fn text_weight(self, value: Uint) -> Self {
    self.text_weight = Some(value);
    self
  }

  pub fn text_color(self, value: Color) -> Self {
    self.text_color = Some(value);
    self
  }

  // 木を辿って syscall を発行する。enum の `UiElement::materialize` から
  // 分岐した先である。
  pub(super) fn materialize(self) -> UiId {
    let id = ui_create(self.into());
    apply_id(id, self.id);
    
    apply_layout_properties(
      id, self.width, self.height,
      self.margin_left, self.margin_right, self.margin_top, self.margin_bottom,
      self.padding_left, self.padding_right, self.padding_top, self.padding_bottom,
      self.background,
    );
    apply_text_properties(id, self.text, self.text_font, self.text_size, self.text_weight, self.text_color);
    match self.child {
      Some(child) => {
        let child_id = child.materialize();
        ui_push_child(id, child_id);
      },
      None => {},
    }
    
    id
  }
}

impl[S] Box[S]: Into[UiElement[S]] {
  fn into(self) -> UiElement[S] {
    UiElement::Box(self)
  }
}
