import package::convert::Into;

pub struct Color {
  // 現在のBiwaにはByte型がないのでUintで表現しているが、
  // いずれも 0 ~ 255 の値に丸められる
  r: Uint,
  g: Uint,
  b: Uint,
  a: Uint,
}

// 0 <= value <= 255
pub struct Alpha {
  value: Uint,
}

impl Alpha {
  pub fn alpha(value: Uint) -> Alpha { Alpha { value = value } }

  pub fn transparent() -> Alpha { Alpha { value = 0 } }

  pub(package) fn is_transparent(self) -> Bool { self.value == 0 }

  pub fn opaque() -> Alpha { Alpha { value = 255 } }

  pub(package) fn is_opaque(self) -> Bool { self.value >= 255 }

  pub(package) fn add(self, rhs: Self) -> Self {
    Self { value = self.value + rhs.value }
  }

  pub(package) fn sub(self, rhs: Self) -> Self {
    Self { value = self.value - rhs.value }
  }
}

impl Alpha: Into[Uint] {
  fn into(self) -> Uint {
    self.value
  }
}

// Biwa std color name derived from CSS named color.
// 
// 16 colors of CSS Level 1 (https://www.w3.org/TR/REC-CSS1/#color-units) are:
// black    #000000 	
// silver   #c0c0c0 	
// gray     #808080 	
// white    #ffffff 	
// maroon   #800000 	
// red      #ff0000 	
// purple   #800080 	
// fuchsi   #ff00ff 	
// green    #008000 	
// lime     #00ff00 	
// olive    #808000 	
// yellow   #ffff00 	
// navy     #000080 	
// blue     #0000ff 	
// teal     #008080 	
// aqua     #00ffff
//
// And colors added in CSS Level 2 (https://www.w3.org/TR/CSS2/syndata.html#value-def-color) are:
// orange   #ffA500
// 
// And if we need more colors,
// we must refer to CSS Colors Level 3 (https://drafts.csswg.org/css-color-3/#svg-color) and define color APIs.
impl Color {
  pub fn new(r: Uint, g: Uint, b: Uint, a: Uint) -> Self {
    Self { r = r, g = g, b = b, a = a }
  }

  pub(super) fn r(self) -> Uint { self.r }

  pub(super) fn g(self) -> Uint { self.g }

  pub(super) fn b(self) -> Uint { self.b }

  pub(super) fn a(self) -> Uint { self.a }

  // black    #000000 	
  pub fn black() -> Self {
    Self {
      r = 0x00,
      g = 0x00,
      b = 0x00,
      a = 0xff,
    }
  }
  
  // silver   #c0c0c0 	
  pub fn silver() -> Self {
    Self {
      r = 0xc0,
      g = 0xc0,
      b = 0xc0,
      a = 0xff,
    }
  }
  
  // gray     #808080 	
  pub fn gray() -> Self {
    Self {
      r = 0x80,
      g = 0x80,
      b = 0x80,
      a = 0xff,
    }
  }

  // white    #ffffff 	
  pub fn white() -> Self {
    Self {
      r = 0xff,
      g = 0xff,
      b = 0xff,
      a = 0xff,
    }
  }

  // maroon   #800000 	
  pub fn maroon() -> Self {
    Self {
      r = 0x80,
      g = 0x00,
      b = 0x00,
      a = 0xff,
    }
  }
  
  // red      #ff0000 	
  pub fn red() -> Self {
    Self {
      r = 0xff,
      g = 0x00,
      b = 0x00,
      a = 0xff,
    }
  }
  
  // purple   #800080 	
  pub fn purple() -> Self {
    Self {
      r = 0x80,
      g = 0x00,
      b = 0x80,
      a = 0xff,
    }
  }
  
  // fuchsi   #ff00ff 	
  pub fn fuchsi() -> Self {
    Self {
      r = 0xff,
      g = 0x00,
      b = 0xff,
      a = 0xff,
    }
  }
  
  // green    #008000 	
  pub fn green() -> Self {
    Self {
      r = 0x00,
      g = 0x80,
      b = 0x00,
      a = 0xff,
    }
  }
  
  // lime     #00ff00 	
  pub fn lime() -> Self {
    Self {
      r = 0x00,
      g = 0xff,
      b = 0x00,
      a = 0xff,
    }
  }
  
  // olive    #808000 	
  pub fn olive() -> Self {
    Self {
      r = 0x80,
      g = 0x80,
      b = 0x00,
      a = 0xff,
    }
  }
  
  // yellow   #ffff00 	
  pub fn yellow() -> Self {
    Self {
      r = 0xff,
      g = 0xff,
      b = 0x00,
      a = 0xff,
    }
  }
  
  // navy     #000080 	
  pub fn navy() -> Self {
    Self {
      r = 0x00,
      g = 0x00,
      b = 0x80,
      a = 0xff,
    }
  }
  
  // blue     #0000ff 	
  pub fn blue() -> Self {
    Self {
      r = 0x00,
      g = 0x00,
      b = 0xff,
      a = 0xff,
    }
  }
  
  // teal     #008080 	
  pub fn teal() -> Self {
    Self {
      r = 0x00,
      g = 0x80,
      b = 0x80,
      a = 0xff,
    }
  }
  
  // aqua     #00ffff
  pub fn aqua() -> Self {
    Self {
      r = 0x00,
      g = 0xff,
      b = 0xff,
      a = 0xff,
    }
  }
  
  // orange   #ffA500
  pub fn orange() -> Self {
    Self {
      r = 0xff,
      g = 0xA5,
      b = 0x00,
      a = 0xff,
    }
  }
}
