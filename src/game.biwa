// 進行中のノベルゲームを表す構造体
// S: ゲーム内で(セーブ、ロードも関係なく)継続して保持したい状態をいくつもメンバに含む構造体
//    - states.likeabilities.akane でakaneというキャラクターのプレイヤーへの好感度にアクセスできる
//    - states.game_difficulty でゲームの難易度にアクセスできる
//    というようにユーザが定義
//
// 以前はキャラクターの束を別の型引数 `C` (`Game[C, S]`) で持っていたが廃止した。
// キャラクターが要るなら `S` のメンバに持つか、scene の中で作る。
[[lang="game"]]
pub struct Game[S] {
  name: String, // ゲームの名前
  states: S,
  // Window の寿命のものの束。プレイの間持ち続け、Window への副作用の経路にする。
  //
  // 文字速度・サイズ・色などの設定 (`Config`) もここにある (`window.config()`)。
  // **エンジンは設定を持たない。** std がそれを読んで絶対値に直してから syscall に渡す。
  window: WindowHandle,
  // 今鳴っている BGM (`change_bgm`)。1 回のプレイの寿命のもの。
  bgm: BgmState,
}

// scene の型。scene は `Game[S]` を受け取って (状態を進めた) `Game[S]` を返す関数である。
//
// `scene foo(g: MyGame) -> MyGame {{ .. }}` は `Scene[MyGameState]` の値として渡せる
// (例えば UI の `Window` の `main_scene` に。`docs/ui-api.md` の改訂版)。
pub type Scene[S] = fn(Game[S]) -> Game[S];

impl[S] Game[S] {
  // `window` は `Window::show()` が作ってランタイムに預け、ランタイムが `SceneStartButton` の
  // `on_click(window)` にそのまま渡したもの。ゲーム側はそれをそのままここに渡す
  // (作り直さないこと。共有が切れる。`WindowHandle` のコメント参照)。
  //
  // 設定 (`Config`) は `Window::config` で与える (プレイをまたいで続くので Window の側に置く)。
  pub fn new(window: WindowHandle, name: String, states: S) -> Self {
    Self {
      name = name,
      states = states,
      window = window,
      bgm = BgmState::new(),
    }
  }

  // Canvas API の出力先。
  pub fn canvas(self) -> CanvasHandle {
    self.window.canvas()
  }
}

// キャラクターを表す構造体
// P: 個々のキャラクターが持つ特有のプロパティを格納するcustom properties
//    ゲーム開発者が必要に応じて定義する
[[lang="character"]]
pub struct Character[P] {
  name: String,
  display_name: String,
  props: P,
  default_visual: Image,
  default_face: Image,
  current_visual: Option[CanvasObject],
  current_face: Option[CanvasObject],
  current_position: Option[Position], // キャラクターの画面上の位置。noneならば画面上にない
  // このキャラのボイスのバス (voice の下の `voice/<キャラ>`)。`Character::new` が作る。1 回のプレイの寿命のもの。
  // 同じキャラの前のボイスを止めるのに使う (今鳴っているボイスを覚えておかなくてよい)。
  voice_bus: Bus,
  // Window の寿命のものの束。描画 (`appear` など) の出力先をここから取る。
  //
  // **暫定**: `Character::new` は `Game` を受け取るが、今は `WindowHandle` だけを保持する
  // (同じ struct を指すので、Window の寿命のものは `Game` と共有される)。
  // Character は将来 `Game[S]` の状態を共有・更新するようになる想定だが、
  // それまでは `Character` 型への影響を最小にするためにこの形にしている。
  window: WindowHandle,
}

