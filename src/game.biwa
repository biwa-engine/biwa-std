import package::string::String;
import package::option::Option;
import image::Image;
import image::CanvasObject;
import ui::GameWindow;
import ui::GameCanvas;
import ui::Position;
import config::Config;

// 進行中のノベルゲームを表す構造体
// C: キャラクター構造体Character[V]のみをいくつもメンバに含む構造体
//    - characters.akane でakaneというキャラクターにアクセスできる
//    というようにユーザが定義
// S: ゲーム内で(セーブ、ロードも関係なく)継続して保持したい状態をいくつもメンバに含む構造体
//    - states.likeabilities.akane でakaneというキャラクターのプレイヤーへの好感度にアクセスできる
//    - states.game_difficulty でゲームの難易度にアクセスできる
//    というようにユーザが定義
[[lang="game"]]
struct Game[C, S] {
  name: String, // ゲームの名前
  characters: C,
  states: S,
  window: GameWindow,

  // 文字速度・サイズ・色などの設定。
  //
  // **エンジンは設定を持たない。** std がここを読んで絶対値に直してから
  // syscall に渡す。
  config: Config,
}

impl[C, S] Game[C, S] {
  // `window` (出力先の束) はランタイムが組み立てて `on_new_game(window)` に渡したもの。
  // ゲーム側はそれをそのままここに渡す。
  fn new(window: GameWindow, name: String, characters: C, states: S, config: Config) -> Self {
    Self {
      name = name,
      characters = characters,
      states = states,
      window = window,
      config = config,
    }
  }

  // Canvas API の出力先。
  //
  // `GameWindow` に Canvas が無い (ランタイムが渡さなかった) のに描こうとするのは
  // ゲーム側の構成の誤りなので、黙って捨てずに止める
  // (`Option::unwrap` → `abort`。Content API の `message_area_of` と同じ扱い)。
  fn canvas(self) -> GameCanvas {
    self.window.canvas.unwrap()
  }
}

// キャラクターを表す構造体
// P: 個々のキャラクターが持つ特有のプロパティを格納するcustom properties
//    ゲーム開発者が必要に応じて定義する
[[lang="character"]]
struct Character[P] {
  name: String,
  display_name: String,
  props: P,
  default_visual: Image,
  default_face: Image,
  current_visual: Option[CanvasObject],
  current_face: Option[CanvasObject],
  current_position: Option[Position], // キャラクターの画面上の位置。noneならば画面上にない
  // 出力先の束。描画 (`appear` など) の出力先をここから取る。
  //
  // **暫定**: `Character::new` は `Game` を受け取るが、今は `GameWindow` だけを保持する。
  // `Game[C, S]` は将来 `Game[S]` (S = ユーザ定義の状態) になり、Character は
  // `Game` の状態を共有・更新するようになる想定だが、それまでは `Character` 型への
  // 影響を最小にするためにこの形にしている。
  window: GameWindow,
}

