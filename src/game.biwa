import package::string::String;
import package::option::Option;
import image::Image;
import canvas::CanvasObject;
import canvas::Position;
import ui::GameWindow;
import ui::GameCanvas;
import config::Config;

// 進行中のノベルゲームを表す構造体
// S: ゲーム内で(セーブ、ロードも関係なく)継続して保持したい状態をいくつもメンバに含む構造体
//    - states.likeabilities.akane でakaneというキャラクターのプレイヤーへの好感度にアクセスできる
//    - states.game_difficulty でゲームの難易度にアクセスできる
//    というようにユーザが定義
//
// 以前はキャラクターの束を別の型引数 `C` (`Game[C, S]`) で持っていたが廃止した。
// キャラクターが要るなら `S` のメンバに持つか、scene の中で作る。
[[lang="game"]]
struct Game[S] {
  name: String, // ゲームの名前
  states: S,
  window: GameWindow,

  // 文字速度・サイズ・色などの設定。
  //
  // **エンジンは設定を持たない。** std がここを読んで絶対値に直してから
  // syscall に渡す。
  config: Config,
}

// scene の型。scene は `Game[S]` を受け取って (状態を進めた) `Game[S]` を返す関数である。
//
// `scene foo(g: MyGame) -> MyGame {{ .. }}` は `Scene[MyGameState]` の値として渡せる
// (例えば UI の `Window` の `main_scene` に。`docs/ui-api.md` の改訂版)。
// wasm では scene は普通の関数である。TypeScript では generator function なので、まだ値にできない。
type Scene[S] = fn(Game[S]) -> Game[S];

impl[S] Game[S] {
  // `window` (出力先の束) はランタイムが組み立てて `on_new_game(window)` に渡したもの。
  // ゲーム側はそれをそのままここに渡す。
  fn new(window: GameWindow, name: String, states: S, config: Config) -> Self {
    Self {
      name = name,
      states = states,
      window = window,
      config = config,
    }
  }

  // Canvas API の出力先。
  //
  // `GameWindow` に Canvas が無い (ランタイムが渡さなかった) のに描こうとするのは
  // ゲーム側の構成の誤りなので、黙って捨てずに止める
  // (`Option::unwrap` → `abort`。Content API の `message_area_of` と同じ扱い)。
  fn canvas(self) -> GameCanvas {
    self.window.canvas.unwrap()
  }
}

// キャラクターを表す構造体
// P: 個々のキャラクターが持つ特有のプロパティを格納するcustom properties
//    ゲーム開発者が必要に応じて定義する
[[lang="character"]]
struct Character[P] {
  name: String,
  display_name: String,
  props: P,
  default_visual: Image,
  default_face: Image,
  current_visual: Option[CanvasObject],
  current_face: Option[CanvasObject],
  current_position: Option[Position], // キャラクターの画面上の位置。noneならば画面上にない
  // 出力先の束。描画 (`appear` など) の出力先をここから取る。
  //
  // **暫定**: `Character::new` は `Game` を受け取るが、今は `GameWindow` だけを保持する。
  // Character は将来 `Game[S]` の状態を共有・更新するようになる想定だが、
  // それまでは `Character` 型への影響を最小にするためにこの形にしている。
  window: GameWindow,
}

